# HAU DigitalSign OCR - Docker Compose environment sample
# Copy file này thành `.env` khi triển khai thật:
#   Copy-Item .env.example .env
#
# Các giá trị mặc định bên dưới chỉ dùng cho local/dev/demo.
# Không commit file `.env` thật vào repository.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=DigitalSign_OCR

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# JWT dùng chung giữa IdentityService, ApiGateway, DocumentService, SignService.
# Production nên dùng chuỗi random dài tối thiểu 32 ký tự.
JWT_SECRET_KEY=change-me-long-random-jwt-secret-at-least-32-characters
JWT_ISSUER=IdentityService
JWT_AUDIENCE=HAU-MicroservicesClients
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Token nội bộ để OCRService PATCH kết quả OCR về DocumentService.
# Giá trị này phải giống nhau ở OCRService và DocumentService.
OCR_SERVICE_TOKEN=change-me-ocr-service-token
