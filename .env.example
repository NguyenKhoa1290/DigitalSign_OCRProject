# HAU DigitalSign OCR - Docker Compose environment sample
# Copy file này thành `.env` khi triển khai thật:
#   Copy-Item .env.example .env
#
# Các giá trị mặc định bên dưới chỉ dùng cho local/dev/demo.
# Không commit file `.env` thật vào repository.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=DigitalSign_OCR

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# JWT dùng chung giữa IdentityService, ApiGateway, DocumentService, SignService.
# Production nên dùng chuỗi random dài tối thiểu 32 ký tự.
JWT_SECRET_KEY=change-me-long-random-jwt-secret-at-least-32-characters
JWT_ISSUER=IdentityService
JWT_AUDIENCE=HAU-MicroservicesClients
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Token nội bộ để OCRService PATCH kết quả OCR về DocumentService.
# Giá trị này phải giống nhau ở OCRService và DocumentService.
OCR_SERVICE_TOKEN=change-me-ocr-service-token

# Email forgot/reset password.
# Default Docker dev dùng Mailpit local: SMTP 1025, UI/API 8025, không auth, không TLS.
# Production/Gmail: dùng App Password 16 ký tự, không dùng mật khẩu đăng nhập Google.
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SECURE_SOCKET_OPTIONS=None
EMAIL_REQUIRE_AUTH=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=noreply@hau.local
EMAIL_FROM_NAME=HAU Documents

# Mẫu Gmail (bỏ comment và thay địa chỉ/app password trong file .env thật):
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SECURE_SOCKET_OPTIONS=StartTls
# EMAIL_REQUIRE_AUTH=true
# EMAIL_USERNAME=your-account@gmail.com
# EMAIL_PASSWORD=your-16-character-app-password
# EMAIL_FROM_EMAIL=your-account@gmail.com
# EMAIL_FROM_NAME=HAU Documents
