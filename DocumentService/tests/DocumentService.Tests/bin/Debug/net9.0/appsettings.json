{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=DigitalSign_OCR;Username=postgres;Password=1111;SSL Mode=Disable"
  },
  "JwtSettings": {
    "Key": "HAU-IdentityService-SuperSecret-Key-2024-MustBe32CharsOrMore!!",
    "Issuer": "IdentityService",
    "Audience": "HAU-MicroservicesClients"
  },
  "MinioSettings": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSSL": false,
    "DefaultBucket": "documents"
  },
  "FileUpload": {
    "MaxFileSizeMB": 50,
    "AllowedExtensions": [ ".pdf", ".docx", ".doc", ".xlsx", ".xls", ".png", ".jpg", ".jpeg", ".tiff" ]
  },
  "KafkaSettings": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "TopicDocumentUploaded": "document.uploaded"
  },
  "AllowedHosts": "*"
