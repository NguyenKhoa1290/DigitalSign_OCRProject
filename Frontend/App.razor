@using Microsoft.AspNetCore.Components.Authorization

<div class="viewport-too-small" role="alert" aria-live="assertive">
    <img src="images/hau-logo.png" alt="Biểu trưng Trường Đại học Kiến trúc Hà Nội" />
    <h1>Màn hình chưa đủ kích thước</h1>
    <p>Thiết bị cần chiều rộng tối thiểu 300px và chiều cao tối thiểu 500px để sử dụng HAU Documents.</p>
</div>

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (!context.User.Identity?.IsAuthenticated ?? true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div style="padding:40px;text-align:center">
                            <h2>Không có quyền truy cập</h2>
                            <p>Bạn không có quyền truy cập trang này.</p>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="loading-state">
                        <div class="spinner spinner-lg"></div>
                        <span>Đang xác thực...</span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Không tìm thấy trang</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="loading-state">
                    <p style="font-size:48px">404</p>
                    <p>Không tìm thấy trang yêu cầu.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
