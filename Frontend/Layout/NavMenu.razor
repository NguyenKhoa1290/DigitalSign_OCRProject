@inject AuthService AuthService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<glass-surface class="liquid-sidebar-shell" radius="22">
    <div class="sidebar">
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon"><img src="images/hau-logo.png" alt="Biểu trưng Trường Đại học Kiến trúc Hà Nội" /></div>
            <div class="sidebar-logo-text"><div class="sidebar-logo-title">HAU Docs</div><div class="sidebar-logo-subtitle">Quản lý Công văn</div></div>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-title">Tổng quan</div>
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>Dashboard</NavLink>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-title">Công văn</div>
            <NavLink class="nav-item" href="/documents"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 01-2-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>Danh sách Công văn</NavLink>
            <AuthorizeView Roles="Clerk,Specialist"><NavLink class="nav-item" href="/documents/create"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>Tạo Công văn mới</NavLink></AuthorizeView>
        </div>

        <AuthorizeView Roles="Manager,BoardOfDirectors"><div class="sidebar-section"><div class="sidebar-section-title">Ký số</div>
            <NavLink class="nav-item" href="/signatures"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>Ký số Tài liệu</NavLink>
            <NavLink class="nav-item" href="/certificates/me"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 01.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>Chứng thư của tôi</NavLink>
        </div></AuthorizeView>

        <AuthorizeView Roles="Admin"><div class="sidebar-section"><div class="sidebar-section-title">Quản trị hệ thống</div>
            <NavLink class="nav-item" href="/admin/users"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>Người dùng</NavLink>
            <NavLink class="nav-item" href="/admin/departments"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>Phòng ban</NavLink>
            <NavLink class="nav-item" href="/admin/certificates"><svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 01.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>Chứng thư số</NavLink>
        </div></AuthorizeView>

        <div class="sidebar-footer"><button id="sidebar-user-card" type="button" class="user-card" @onclick="OpenProfile" aria-label="Mở trang cá nhân"><div class="user-avatar">@(_userName?.Length > 0 ? _userName[0].ToString().ToUpper() : "U")</div><div class="user-info"><div class="user-name">@_userName</div><div class="user-role">@GetRoleLabel(_role)</div></div></button></div>
    </div>
</glass-surface>

<AuthorizeView Roles="Admin"><Authorized><flight-taskbar class="mobile-flight-taskbar" labels="Tổng quan|Công văn|Người dùng|Phòng ban|Chứng thư|Cá nhân" icons="home|document|users|building|certificate|user" routes="/|/documents|/admin/users|/admin/departments|/admin/certificates|/profile" aria-label="Điều hướng chính"></flight-taskbar></Authorized></AuthorizeView>
<AuthorizeView Roles="Manager,BoardOfDirectors"><Authorized><flight-taskbar class="mobile-flight-taskbar" labels="Tổng quan|Công văn|Ký số|Chứng thư|Cá nhân" icons="home|document|sign|certificate|user" routes="/|/documents|/signatures|/certificates/me|/profile" aria-label="Điều hướng chính"></flight-taskbar></Authorized></AuthorizeView>
<AuthorizeView Roles="Clerk,Specialist"><Authorized><flight-taskbar class="mobile-flight-taskbar" labels="Tổng quan|Công văn|Tạo mới|Công văn|Cá nhân" icons="home|document|plus|document|user" routes="/|/documents|/documents/create|/documents|/profile" aria-label="Điều hướng chính"></flight-taskbar></Authorized></AuthorizeView>

@code {
    private string? _userName;
    private string? _role;
    private IJSObjectReference? _taskbarModule;
    private DotNetObjectReference<NavMenu>? _taskbarReference;

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        _userName = await AuthService.GetUserNameAsync();
        _role = await AuthService.GetRoleAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _taskbarModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/liquid-glass.js?v=20261011-5");
        _taskbarReference = DotNetObjectReference.Create(this);
        await _taskbarModule.InvokeVoidAsync("bindTaskbarNavigation", _taskbarReference);
    }

    [JSInvokable]
    public void NavigateFromTaskbar(string route)
    {
        if (route.StartsWith('/') && !route.StartsWith("//")) NavManager.NavigateTo(route);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(SyncTaskbarSelectionAsync);
    }

    private async Task SyncTaskbarSelectionAsync()
    {
        if (_taskbarModule is not null) await _taskbarModule.InvokeVoidAsync("syncTaskbarSelection");
    }

    public async ValueTask DisposeAsync()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        if (_taskbarModule is not null)
        {
            await _taskbarModule.InvokeVoidAsync("unbindTaskbarNavigation");
            await _taskbarModule.DisposeAsync();
        }
        _taskbarReference?.Dispose();
    }

    private void OpenProfile() => NavManager.NavigateTo("/profile");
    private static string GetRoleLabel(string? role) => role switch { "Admin" => "Quản trị viên", "Clerk" => "Văn thư", "Specialist" => "Chuyên viên", "Manager" => "Lãnh đạo Phòng", "BoardOfDirectors" => "Ban Giám hiệu", _ => role ?? "Người dùng" };
}
