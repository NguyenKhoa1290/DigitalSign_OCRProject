@inject AuthService AuthService
@inject AdminService AdminService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IToastService Toast

<div class="sidebar">
    <div class="sidebar-logo">
        <div class="sidebar-logo-icon">
            <img src="images/hau-logo.png" alt="Biểu trưng Trường Đại học Kiến trúc Hà Nội" />
        </div>
        <div class="sidebar-logo-text">
            <div class="sidebar-logo-title">HAU Docs</div>
            <div class="sidebar-logo-subtitle">Quản lý Công văn</div>
        </div>
    </div>

    <div class="sidebar-section">
        <div class="sidebar-section-title">Tổng quan</div>
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Dashboard
        </NavLink>
    </div>

    <div class="sidebar-section">
        <div class="sidebar-section-title">Công văn</div>
        <NavLink class="nav-item" href="/documents">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Danh sách Công văn
        </NavLink>

        <AuthorizeView Roles="Clerk,Specialist">
            <NavLink class="nav-item" href="/documents/create">
                <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Tạo Công văn mới
            </NavLink>
        </AuthorizeView>
    </div>

    <AuthorizeView Roles="Manager,BoardOfDirectors">
        <div class="sidebar-section">
            <div class="sidebar-section-title">Ký số</div>
            <NavLink class="nav-item" href="/signatures">
                <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                Ký số Tài liệu
            </NavLink>
            <NavLink class="nav-item" href="/certificates/me">
                <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 01.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
                Chứng thư của tôi
            </NavLink>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <div class="sidebar-section">
            <div class="sidebar-section-title">Quản trị hệ thống</div>
            <NavLink class="nav-item" href="/admin/users">
                <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                Người dùng
            </NavLink>
            <NavLink class="nav-item" href="/admin/departments">
                <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                Phòng ban
            </NavLink>
            <NavLink class="nav-item" href="/admin/certificates">
                <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
                Chứng thư số
            </NavLink>
        </div>
    </AuthorizeView>

    <div class="sidebar-footer">
        <button type="button" class="user-card" @onclick="ToggleAccountMenu"
                aria-expanded="@_showAccountMenu" aria-label="Mở menu tài khoản">
            <div class="user-avatar">@(_userName?.Length > 0 ? _userName[0].ToString().ToUpper() : "U")</div>
            <div class="user-info">
                <div class="user-name">@_userName</div>
                <div class="user-role">@GetRoleLabel(_role)</div>
            </div>
            <span class="account-menu-icon" aria-hidden="true">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
            </span>
        </button>
    </div>
</div>

@if (_showAccountMenu)
{
    <button type="button" class="account-menu-backdrop" @onclick="CloseAccountMenu"
            aria-label="Đóng menu tài khoản"></button>
    <div class="account-menu-popover" role="menu">
        <div class="account-menu-heading">
            <div class="user-avatar">@(_userName?.Length > 0 ? _userName[0].ToString().ToUpper() : "U")</div>
            <div>
                <div class="account-menu-name">@_userName</div>
                <div class="account-menu-role">@GetRoleLabel(_role)</div>
            </div>
        </div>
        <button type="button" class="account-menu-action" @onclick="OpenProfileEditor" role="menuitem">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            Chỉnh sửa thông tin
        </button>
        <button type="button" class="account-menu-action account-menu-logout" @onclick="Logout" role="menuitem">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            Đăng xuất
        </button>
    </div>
}

@if (_showProfileEditor)
{
    <div class="modal-overlay account-profile-overlay" role="presentation" @onclick="CloseProfileEditor">
        <div class="modal account-profile-modal" role="dialog" aria-modal="true"
             aria-labelledby="profile-editor-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 id="profile-editor-title" class="modal-title">Chỉnh sửa thông tin</h2>
                <button type="button" class="modal-close" @onclick="CloseProfileEditor" aria-label="Đóng">×</button>
            </div>
            <div class="modal-body">
                @if (_isLoadingProfile)
                {
                    <div class="loading-state account-profile-loading">
                        <div class="spinner"></div>
                        <span>Đang tải thông tin...</span>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label required" for="profile-full-name">Họ và tên</label>
                        <input id="profile-full-name" class="form-control" maxlength="100"
                               @bind="_profileFullName" disabled="@_isSavingProfile" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="profile-email">Email</label>
                        <input id="profile-email" type="email" class="form-control" maxlength="100"
                               @bind="_profileEmail" disabled="@_isSavingProfile" />
                    </div>
                    <div class="form-group account-profile-last-field">
                        <label class="form-label" for="profile-phone">Số điện thoại</label>
                        <input id="profile-phone" type="tel" class="form-control" maxlength="15"
                               @bind="_profilePhone" disabled="@_isSavingProfile" />
                    </div>
                }
            </div>
            @if (!_isLoadingProfile)
            {
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" @onclick="CloseProfileEditor"
                            disabled="@_isSavingProfile">Hủy</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveProfile"
                            disabled="@_isSavingProfile">
                        @if (_isSavingProfile)
                        {
                            <span class="spinner spinner-sm"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <span>Lưu thay đổi</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    private string? _userName;
    private string? _role;
    private bool _showAccountMenu;
    private bool _showProfileEditor;
    private bool _isLoadingProfile;
    private bool _isSavingProfile;
    private UserDto? _currentUser;
    private string _profileFullName = string.Empty;
    private string _profileEmail = string.Empty;
    private string _profilePhone = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _userName = await AuthService.GetUserNameAsync();
        _role = await AuthService.GetRoleAsync();
    }

    private async Task Logout()
    {
        _showAccountMenu = false;
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/login", forceLoad: true);
    }

    private void ToggleAccountMenu() => _showAccountMenu = !_showAccountMenu;

    private void CloseAccountMenu() => _showAccountMenu = false;

    private async Task OpenProfileEditor()
    {
        _showAccountMenu = false;
        _showProfileEditor = true;
        _isLoadingProfile = true;

        try
        {
            _currentUser = await AdminService.GetCurrentUserAsync();
            if (_currentUser is null)
            {
                Toast.ShowError("Không thể tải thông tin tài khoản.");
                _showProfileEditor = false;
                return;
            }

            _profileFullName = _currentUser.FullName;
            _profileEmail = _currentUser.Email ?? string.Empty;
            _profilePhone = _currentUser.PhoneNumber ?? string.Empty;
        }
        catch
        {
            Toast.ShowError("Không thể tải thông tin tài khoản.");
            _showProfileEditor = false;
        }
        finally
        {
            _isLoadingProfile = false;
        }
    }

    private void CloseProfileEditor()
    {
        if (_isSavingProfile) return;
        _showProfileEditor = false;
    }

    private async Task SaveProfile()
    {
        if (_currentUser is null) return;
        if (string.IsNullOrWhiteSpace(_profileFullName))
        {
            Toast.ShowWarning("Vui lòng nhập họ và tên.");
            return;
        }

        _isSavingProfile = true;
        try
        {
            var result = await AdminService.UpdateUserAsync(_currentUser.Id, new UpdateUserDto
            {
                FullName = _profileFullName.Trim(),
                Email = _profileEmail.Trim(),
                PhoneNumber = string.IsNullOrWhiteSpace(_profilePhone) ? null : _profilePhone.Trim(),
                DepartmentId = _currentUser.DepartmentId,
                IsActive = _currentUser.IsActive,
                Role = _currentUser.Role
            });

            if (result is null)
            {
                Toast.ShowError("Cập nhật thông tin thất bại.");
                return;
            }

            _currentUser = result;
            _userName = result.FullName;
            _showProfileEditor = false;
            Toast.ShowSuccess("Đã cập nhật thông tin tài khoản.");
        }
        catch
        {
            Toast.ShowError("Cập nhật thông tin thất bại.");
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private static string GetRoleLabel(string? role) => role switch
    {
        "Admin" => "Quản trị viên",
        "Clerk" => "Văn thư",
        "Specialist" => "Chuyên viên",
        "Manager" => "Lãnh đạo Phòng",
        "BoardOfDirectors" => "Ban Giám hiệu",
        _ => role ?? "Người dùng"
    };
}
