@page "/admin/organization"
@page "/admin/users"
@page "/admin/departments"
@using Blazored.LocalStorage
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager NavManager
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!_ready)
{
    <LoadingSpinner />
}
else
{
    <div class="organization-tabs" @ref="_tabs" role="tablist" aria-label="Quản lý tổ chức">
        <glass-surface class="organization-selector" radius="10" aria-hidden="true"></glass-surface>
        <button id="organization-users-tab" type="button" role="tab" aria-selected="@(_selected == "users" ? "true" : "false")"
                aria-controls="organization-panel" class="@(_selected == "users" ? "selected" : "")"
                @onclick="@(() => OpenSection("users"))">Người dùng</button>
        <button id="organization-departments-tab" type="button" role="tab" aria-selected="@(_selected == "departments" ? "true" : "false")"
                aria-controls="organization-panel" class="@(_selected == "departments" ? "selected" : "")"
                @onclick="@(() => OpenSection("departments"))">Phòng ban</button>
    </div>
    <div id="organization-panel" role="tabpanel" aria-labelledby="@($"organization-{_selected}-tab")">
        @if (_selected == "departments")
        {
            <Departments />
        }
        else
        {
            <Users />
        }
    </div>
}

@code {
    private const string StorageKey = "organization.active-section";
    private string _selected = "users";
    private bool _ready;
    private ElementReference _tabs;
    private IJSObjectReference? _switchModule;
    private IJSObjectReference? _switchMotion;

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        await SyncSectionAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_ready) return;
        if (_switchModule is null)
            _switchModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/liquid-organization-tabs.js");
        if (_switchMotion is null)
            _switchMotion = await _switchModule.InvokeAsync<IJSObjectReference>("createOrganizationSwitch", _tabs, _selected);
        else
            await _switchMotion.InvokeVoidAsync("setSelected", _selected);
    }

    private async Task SyncSectionAsync()
    {
        var path = new Uri(NavManager.Uri).AbsolutePath.TrimEnd('/');
        _selected = path switch
        {
            "/admin/users" => "users",
            "/admin/departments" => "departments",
            _ => await LocalStorage.GetItemAsync<string>(StorageKey) == "departments" ? "departments" : "users"
        };
        await LocalStorage.SetItemAsync(StorageKey, _selected);
        _ready = true;
    }

    private void OpenSection(string section)
    {
        _selected = section;
        NavManager.NavigateTo($"/admin/{section}");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await SyncSectionAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        if (_switchMotion is not null)
        {
            await _switchMotion.InvokeVoidAsync("dispose");
            await _switchMotion.DisposeAsync();
        }
        if (_switchModule is not null) await _switchModule.DisposeAsync();
    }
}
