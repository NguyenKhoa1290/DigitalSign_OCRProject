@attribute [Authorize(Roles = "Admin")]
@inject AdminService AdminService
@inject IToastService Toast

<PageTitle>Quản lý Người dùng - HAU Admin</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý Người dùng</h1>
        <p class="page-subtitle">Tạo, chỉnh sửa và phân quyền người dùng</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="ShowCreateModal">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Thêm người dùng
        </button>
    </div>
</div>

<div class="filter-bar">
    <div class="search-box">
        <svg class="search-box-icon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="text" class="form-control" placeholder="Tìm kiếm người dùng..." aria-label="Tìm kiếm người dùng"
               @bind="_searchQuery" @bind:event="oninput" @bind:after="OnSearchChanged" />
    </div>
</div>

@if (_isLoading)
{
    <LoadingSpinner />
}
else if (_result == null || _result.Items.Count == 0)
{
    <div class="table-wrapper">
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <p class="empty-state-title">Không tìm thấy người dùng</p>
        </div>
    </div>
}
else
{
    <div class="table-wrapper user-desktop-list">
        <table class="table">
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Mã cán bộ/giảng viên</th>
                    <th>Vai trò</th>
                    <th>Phòng ban</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th class="actions-heading actions-column">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _result.Items)
                {
                    <tr class="user-row"
                        @ontouchstart="() => BeginLongPress(user)"
                        @ontouchend="CancelLongPress"
                        @ontouchcancel="CancelLongPress"
                        @ontouchmove="CancelLongPress"
                        @oncontextmenu:preventDefault
                        @onclick:stopPropagation>
                        <td>
                            <div class="user-cell">
                                <div class="user-table-avatar">
                                    @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="user-full-name">@user.FullName</div>
                                    <div class="user-email">@user.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="username-cell">@user.Username</td>
                        <td><span class="role-badge role-@user.Role">@GetRoleLabel(user.Role)</span></td>
                        <td>@(user.DepartmentName ?? "—")</td>
                        <td>
                            @if (user.IsActive)
                            { <span class="badge badge-green">Hoạt động</span> }
                            else
                            { <span class="badge badge-gray">Vô hiệu</span> }
                        </td>
                        <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="actions-column actions-cell">
                            <div class="row-actions">
                                <button type="button" class="row-action-trigger"
                                        aria-label="Mở thao tác cho @user.FullName"
                                        aria-haspopup="menu"
                                        aria-expanded="@(_actionUser?.Id == user.Id)"
                                        @onclick="(args) => ShowActionMenu(user, args)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <circle cx="5" cy="12" r="1.8" />
                                        <circle cx="12" cy="12" r="1.8" />
                                        <circle cx="19" cy="12" r="1.8" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="user-mobile-list">
        <p class="mobile-list-hint">Nhấn giữ một thẻ để mở thao tác.</p>
        @foreach (var user in _result.Items)
        {
            <article class="user-mobile-card"
                     @key="user.Id"
                     @ontouchstart="() => BeginLongPress(user)"
                     @ontouchend="CancelLongPress"
                     @ontouchcancel="CancelLongPress"
                     @ontouchmove="CancelLongPress"
                     @oncontextmenu:preventDefault>
                <div class="user-mobile-header">
                    <div class="user-table-avatar">
                        @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                    </div>
                    <div class="user-mobile-identity">
                        <div class="user-full-name">@user.FullName</div>
                        <div class="user-email">@user.Email</div>
                    </div>
                    @if (user.IsActive)
                    { <span class="badge badge-green">Hoạt động</span> }
                    else
                    { <span class="badge badge-gray">Vô hiệu</span> }
                </div>
                <dl class="user-mobile-details">
                    <div>
                        <dt>Mã cán bộ/giảng viên</dt>
                        <dd class="username-cell">@user.Username</dd>
                    </div>
                    <div>
                        <dt>Vai trò</dt>
                        <dd>@GetRoleLabel(user.Role)</dd>
                    </div>
                    <div>
                        <dt>Phòng ban</dt>
                        <dd>@(user.DepartmentName ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Ngày tạo</dt>
                        <dd>@user.CreatedAt.ToString("dd/MM/yyyy")</dd>
                    </div>
                </dl>
            </article>
        }
    </div>

    <div class="pagination">
        <span class="pagination-info">@_result.TotalCount người dùng</span>
        <div class="pagination-controls">
            <button class="page-btn" @onclick="PrevPage" disabled="@(!_result.HasPreviousPage)">‹</button>
            @for (int i = 1; i <= _result.TotalPages; i++)
            {
                int pg = i;
                <button class="page-btn @(pg == _currentPage ? "active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
            }
            <button class="page-btn" @onclick="NextPage" disabled="@(!_result.HasNextPage)">›</button>
        </div>
    </div>
}

@if (_actionUser != null)
{
    <button type="button" class="user-action-backdrop" aria-label="Đóng menu thao tác"
            @onclick="CloseActionMenu"></button>
    <div class="user-action-menu @(_actionMenuFromTouch ? "from-long-press" : "")"
         style="--action-x:@($"{_actionMenuX:0}px"); --action-y:@($"{_actionMenuY:0}px");"
         role="menu" aria-label="Thao tác với @_actionUser.FullName">
        <div class="user-action-name">@_actionUser.FullName</div>
        <button type="button" class="user-action-item" role="menuitem" @onclick="EditActionUser">
            <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            Sửa
        </button>
        <button type="button" class="user-action-item" role="menuitem" @onclick="ResetPasswordActionUser">
            <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-5-5V8a5 5 0 0110 0v4M5 12h14v9H5z" />
            </svg>
            Đặt lại mật khẩu
        </button>
        <button type="button" class="user-action-item user-action-delete" role="menuitem" @onclick="DeleteActionUser">
            <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636 5.636 18.364M5.636 5.636l12.728 12.728" />
            </svg>
            Xóa
        </button>
    </div>
}

@if (_resettingUser != null)
{
    <div class="modal-overlay" @onclick="CloseResetModal">
        <div class="modal user-reset-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">Đặt lại mật khẩu</span>
                <button type="button" class="modal-close" @onclick="CloseResetModal" disabled="@_isResetting">&times;</button>
            </div>
            <div class="modal-body">
                <p class="user-reset-note">Cấp mật khẩu tạm cho <strong>@_resettingUser.FullName</strong> (@_resettingUser.Username). Phiên đăng nhập cũ sẽ bị thu hồi. Người dùng phải nhập và xác minh lại email ở lần đăng nhập tiếp theo.</p>
                <div class="form-group">
                    <label class="form-label required" for="temporary-password">Mật khẩu tạm (tối thiểu 8 ký tự)</label>
                    <input id="temporary-password" type="password" class="form-control" autocomplete="new-password"
                           @bind="_temporaryPassword" disabled="@_isResetting" />
                </div>
                <div class="form-group">
                    <label class="form-label required" for="confirm-temporary-password">Xác nhận mật khẩu tạm</label>
                    <input id="confirm-temporary-password" type="password" class="form-control" autocomplete="new-password"
                           @bind="_confirmTemporaryPassword" disabled="@_isResetting" />
                </div>
                <p class="user-reset-note">Sau khi đặt lại, hãy chuyển mật khẩu tạm cho người dùng qua kênh riêng.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" @onclick="CloseResetModal" disabled="@_isResetting">Hủy</button>
                <button type="button" class="btn btn-primary" @onclick="SaveResetPassword" disabled="@_isResetting">
                    @(_isResetting ? "Đang đặt lại..." : "Đặt lại mật khẩu")
                </button>
            </div>
        </div>
    </div>
}

<!-- Create/Edit Modal -->
@if (_showFormModal)
{
    <div class="modal-overlay">
        <div class="modal modal-lg user-modal" role="dialog" aria-modal="true" aria-labelledby="user-form-title">
            <div class="modal-header">
                <span id="user-form-title" class="modal-title">@(_editingUser == null ? "Thêm người dùng" : "Chỉnh sửa người dùng")</span>
                <button type="button" class="modal-close" aria-label="Đóng" @onclick="CloseModal" disabled="@_isSaving">&times;</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <p class="user-form-error" role="alert">@_formError</p>
                }
                <fieldset class="user-form-fields" disabled="@_isSaving">
                <div class="user-form-grid">
                    <div class="form-group">
                        <label class="form-label required">Họ tên</label>
                        <input type="text" class="form-control" @bind="_formFullName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Mã cán bộ/giảng viên</label>
                        <input type="text" class="form-control" @bind="_formUsername" disabled="@(_editingUser != null)" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email (người dùng sẽ xác minh khi đăng nhập lần đầu)</label>
                        <input type="email" class="form-control" @bind="_formEmail" />
                    </div>
                    @if (_editingUser == null)
                    {
                        <div class="form-group">
                            <label class="form-label required">Mật khẩu</label>
                            <input type="password" class="form-control" @bind="_formPassword" />
                        </div>
                    }
                    <div class="form-group">
                        <label class="form-label required" for="user-role-select">Vai trò</label>
                        <CustomSelect Id="user-role-select"
                                      @bind-Value="_formRole"
                                      Options="RoleOptions"
                                      MaxOptionsHeight="160" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input type="tel" class="form-control" @bind="_formPhone" />
                    </div>
                </div>
                <DepartmentAssignmentPicker Departments="_formDepartments" @bind-Value="_formDepartmentId" />
                @if (_editingUser != null)
                {
                    <div class="form-group">
                        <label class="active-checkbox">
                            <input type="checkbox" @bind="_formIsActive" />
                            <span class="form-label active-checkbox-label">Tài khoản đang hoạt động</span>
                        </label>
                    </div>
                }
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" @onclick="CloseModal" disabled="@_isSaving">Hủy</button>
                <button type="button" class="btn btn-primary" @onclick="SaveUser" disabled="@_isSaving">
                    @if (_isSaving)
                    { <div class="spinner spinner-sm user-spinner"></div><span>Đang lưu...</span> }
                    else { <span>@(_editingUser == null ? "Thêm" : "Lưu thay đổi")</span> }
                </button>
            </div>
        </div>
    </div>
}

<ConfirmDialog @bind-IsVisible="_showDeleteConfirm" Title="Xóa người dùng"
    Message="@($"Bạn có chắc muốn xóa người dùng '{_deletingUser?.FullName}'? Hành động này không thể hoàn tác.")"
    OnConfirm="DeleteUser" ConfirmText="Xóa" />

@code {
    private bool _isLoading = true;
    private PagedResult<UserDto>? _result;
    private string _searchQuery = "";
    private int _currentPage = 1;
    private const int _pageSize = 20;

    private bool _showFormModal;
    private bool _isSaving;
    private string? _formError;
    private UserDto? _editingUser;
    private string _formFullName = "", _formUsername = "", _formEmail = "", _formPassword = "", _formRole = "", _formPhone = "";
    private bool _formIsActive = true;
    private Guid? _formDepartmentId;
    private IReadOnlyList<DepartmentDto> _formDepartments = Array.Empty<DepartmentDto>();

    private static readonly IReadOnlyList<SelectOption> RoleOptions = new List<SelectOption>
    {
        new("", "Chọn vai trò"),
        new("Admin", "Quản trị viên"),
        new("Clerk", "Văn thư"),
        new("Specialist", "Chuyên viên"),
        new("Manager", "Lãnh đạo Phòng"),
        new("BoardOfDirectors", "Ban Giám hiệu")
    };

    private bool _showDeleteConfirm;
    private UserDto? _deletingUser;
    private UserDto? _resettingUser;
    private string _temporaryPassword = "", _confirmTemporaryPassword = "";
    private bool _isResetting;

    private UserDto? _actionUser;
    private bool _actionMenuFromTouch;
    private double _actionMenuX;
    private double _actionMenuY;
    private System.Threading.CancellationTokenSource? _longPressCts;

    private System.Threading.CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync() => await LoadUsers();

    private async Task LoadUsers()
    {
        CloseActionMenu();
        _isLoading = true;
        try { _result = await AdminService.GetUsersAsync(_currentPage, _pageSize, _searchQuery); }
        catch { Toast.ShowError("Lỗi tải danh sách người dùng."); }
        _isLoading = false;
    }

    private async Task OnSearchChanged()
    {
        _cts?.Cancel(); _cts = new();
        try { await Task.Delay(400, _cts.Token); _currentPage = 1; await LoadUsers(); }
        catch (TaskCanceledException) { }
    }

    private async Task ShowCreateModal()
    {
        CloseActionMenu();
        if (!await LoadDepartmentOptions()) return;
        _editingUser = null;
        _formFullName = _formUsername = _formEmail = _formPassword = _formRole = _formPhone = "";
        _formDepartmentId = null;
        _formIsActive = true;
        _formError = null;
        _showFormModal = true;
    }

    private async Task ShowEditModal(UserDto user)
    {
        if (!await LoadDepartmentOptions()) return;
        _editingUser = user;
        _formFullName = user.FullName;
        _formUsername = user.Username;
        _formEmail = user.Email ?? string.Empty;
        _formRole = user.Role;
        _formPhone = user.PhoneNumber ?? "";
        _formIsActive = user.IsActive;
        _formDepartmentId = user.DepartmentId;
        _formError = null;
        _showFormModal = true;
    }

    private async Task<bool> LoadDepartmentOptions()
    {
        try
        {
            var departments = await AdminService.GetDepartmentsAsync();
            if (departments == null)
            {
                Toast.ShowError("Không tải được danh sách phòng ban. Vui lòng thử lại.");
                return false;
            }
            _formDepartments = departments;
            return true;
        }
        catch
        {
            Toast.ShowError("Không tải được danh sách phòng ban. Vui lòng thử lại.");
            return false;
        }
    }

    private void ShowActionMenu(UserDto user, Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        CancelLongPress();
        _actionUser = user;
        _actionMenuFromTouch = false;
        _actionMenuX = args.ClientX;
        _actionMenuY = args.ClientY;
    }

    private void BeginLongPress(UserDto user)
    {
        CancelLongPress();
        _longPressCts = new();
        _ = OpenActionMenuAfterHoldAsync(user, _longPressCts.Token);
    }

    private async Task OpenActionMenuAfterHoldAsync(UserDto user, System.Threading.CancellationToken token)
    {
        try
        {
            await Task.Delay(550, token);
            _actionUser = user;
            _actionMenuFromTouch = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private void CancelLongPress()
    {
        _longPressCts?.Cancel();
        _longPressCts?.Dispose();
        _longPressCts = null;
    }

    private void CloseActionMenu()
    {
        CancelLongPress();
        _actionUser = null;
        _actionMenuFromTouch = false;
    }

    private async Task EditActionUser()
    {
        var user = _actionUser;
        CloseActionMenu();
        if (user != null) await ShowEditModal(user);
    }

    private void DeleteActionUser()
    {
        var user = _actionUser;
        CloseActionMenu();
        if (user != null) ShowDeleteConfirm(user);
    }

    private void ResetPasswordActionUser()
    {
        var user = _actionUser;
        CloseActionMenu();
        if (user == null) return;
        _resettingUser = user;
        _temporaryPassword = _confirmTemporaryPassword = string.Empty;
    }

    private void CloseResetModal()
    {
        if (_isResetting) return;
        _resettingUser = null;
        _temporaryPassword = _confirmTemporaryPassword = string.Empty;
    }

    private async Task SaveResetPassword()
    {
        if (_resettingUser == null) return;
        if (_temporaryPassword.Length < 8 || _temporaryPassword.Length > 128)
        { Toast.ShowWarning("Mật khẩu tạm phải từ 8 đến 128 ký tự."); return; }
        if (_temporaryPassword != _confirmTemporaryPassword)
        { Toast.ShowWarning("Mật khẩu xác nhận không khớp."); return; }

        _isResetting = true;
        try
        {
            var success = await AdminService.ResetUserPasswordAsync(_resettingUser.Id, _temporaryPassword, _confirmTemporaryPassword);
            if (success)
            {
                _isResetting = false;
                CloseResetModal();
                Toast.ShowSuccess("Đã đặt lại mật khẩu. Người dùng cần xác minh lại email khi đăng nhập.");
                await LoadUsers();
            }
            else Toast.ShowError("Đặt lại mật khẩu thất bại.");
        }
        catch { Toast.ShowError("Đặt lại mật khẩu thất bại."); }
        finally { _isResetting = false; }
    }

    private void CloseModal()
    {
        if (_isSaving) return;
        _showFormModal = false;
        _formError = null;
    }

    private async Task SaveUser()
    {
        if (_isSaving || !_showFormModal) return;
        _formError = null;
        // Validate đầy đủ trên frontend trước khi gửi
        if (string.IsNullOrWhiteSpace(_formFullName))
        { Toast.ShowWarning("Vui lòng nhập họ tên."); return; }
        if (string.IsNullOrWhiteSpace(_formUsername) && _editingUser == null)
        { Toast.ShowWarning("Vui lòng nhập mã cán bộ/giảng viên."); return; }
        if (string.IsNullOrWhiteSpace(_formPassword) && _editingUser == null)
        { Toast.ShowWarning("Vui lòng nhập mật khẩu tạm thời."); return; }
        if (_formPassword.Length < 6 && _editingUser == null)
        { Toast.ShowWarning("Mật khẩu phải có ít nhất 6 ký tự."); return; }
        if (string.IsNullOrWhiteSpace(_formRole))
        { Toast.ShowWarning("Vui lòng chọn vai trò."); return; }

        var departmentId = _formDepartmentId;

        _isSaving = true;
        try
        {
            if (_editingUser == null)
            {
                var dto = new CreateUserDto
                {
                    FullName     = _formFullName,
                    Username     = _formUsername,
                    Email        = string.IsNullOrWhiteSpace(_formEmail) ? null : _formEmail.Trim(),
                    Password     = _formPassword,
                    Role         = _formRole,
                    PhoneNumber  = string.IsNullOrWhiteSpace(_formPhone) ? null : _formPhone.Trim(),
                    DepartmentId = departmentId
                };
                var result = await AdminService.CreateUserAsync(dto);
                if (result != null) { Toast.ShowSuccess("Tạo người dùng thành công! Người dùng sẽ xác minh email và đổi mật khẩu khi đăng nhập lần đầu."); _showFormModal = false; await LoadUsers(); }
                else _formError = "Không thể xác nhận kết quả tạo người dùng. Hãy kiểm tra danh sách trước khi thử lại.";
            }
            else
            {
                var dto = new UpdateUserDto
                {
                    FullName = _formFullName,
                    Email = string.IsNullOrWhiteSpace(_formEmail) ? null : _formEmail.Trim(),
                    PhoneNumber = string.IsNullOrWhiteSpace(_formPhone) ? null : _formPhone.Trim(),
                    Role = _formRole, DepartmentId = departmentId, IsActive = _formIsActive
                };
                var result = await AdminService.UpdateUserAsync(_editingUser.Id, dto);
                if (result != null) { Toast.ShowSuccess("Cập nhật thành công!"); _showFormModal = false; await LoadUsers(); }
                else _formError = "Cập nhật thất bại. Vui lòng kiểm tra thông tin và thử lại.";
            }
        }
        catch (HttpRequestException ex)
        {
            _formError = ex.StatusCode.HasValue ? ex.Message
                : "Mất kết nối khi lưu người dùng. Hãy kiểm tra danh sách trước khi thử lại.";
        }
        catch (TaskCanceledException)
        {
            _formError = "Yêu cầu lưu quá thời gian chờ. Hãy kiểm tra danh sách trước khi thử lại.";
        }
        catch
        {
            _formError = "Chưa xác nhận được kết quả lưu người dùng. Hãy kiểm tra danh sách trước khi thử lại.";
        }
        finally { _isSaving = false; }
    }

    private void ShowDeleteConfirm(UserDto user) { _deletingUser = user; _showDeleteConfirm = true; }

    private async Task DeleteUser()
    {
        if (_deletingUser == null) return;
        var success = await AdminService.DeleteUserAsync(_deletingUser.Id);
        if (success) { Toast.ShowSuccess("Xóa người dùng thành công!"); await LoadUsers(); }
        else Toast.ShowError("Xóa thất bại.");
    }

    private async Task PrevPage() { if (_currentPage > 1) { _currentPage--; await LoadUsers(); } }
    private async Task NextPage() { if (_result?.HasNextPage == true) { _currentPage++; await LoadUsers(); } }
    private async Task GoToPage(int page) { _currentPage = page; await LoadUsers(); }

    private static string GetRoleLabel(string role) => role switch
    {
        "Admin" => "Admin",
        "Clerk" => "Văn thư",
        "Specialist" => "Chuyên viên",
        "Manager" => "Lãnh đạo",
        "BoardOfDirectors" => "Ban Giám hiệu",
        _ => role
    };
}
