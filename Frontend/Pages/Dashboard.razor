@page "/"
@attribute [Authorize]
@inject AuthService AuthService
@inject AdminService AdminService
@inject NavigationManager NavManager

<PageTitle>Dashboard - HAU Công văn</PageTitle>

<h1 class="page-title">Dashboard</h1>
<p class="page-subtitle">Xin chào @_userName! Chào mừng bạn đến với hệ thống quản lý công văn HAU.</p>

@if (_isLoading)
{
    <LoadingSpinner Message="Đang tải dữ liệu..." />
}
else
{
    @if (_role == "Admin")
    {
        <div class="stat-grid">
            <div class="stat-card" style="--stat-color:#3b82f6;--stat-bg:#eff6ff">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Tổng người dùng</div>
                    <div class="stat-value">@_stats?.TotalUsers</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#10b981;--stat-bg:#ecfdf5">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Tổng văn bản</div>
                    <div class="stat-value">@_stats?.TotalDocuments</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#f59e0b;--stat-bg:#fffbeb">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chờ xử lý</div>
                    <div class="stat-value">@_stats?.PendingDocuments</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#6366f1;--stat-bg:#eef2ff">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chứng thư số hoạt động</div>
                    <div class="stat-value">@_stats?.ActiveCertificates</div>
                </div>
            </div>
        </div>
    }
    else if (_role == "Clerk")
    {
        <div class="stat-grid">
            <div class="stat-card" style="--stat-color:#3b82f6;--stat-bg:#eff6ff">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Công văn hôm nay</div>
                    <div class="stat-value">@_stats?.TodayDocuments</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#f59e0b;--stat-bg:#fffbeb">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chờ xử lý OCR</div>
                    <div class="stat-value">@_stats?.PendingDocuments</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#10b981;--stat-bg:#ecfdf5">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Đã ban hành</div>
                    <div class="stat-value">@_stats?.PublishedDocuments</div>
                </div>
            </div>
        </div>
    }
    else if (_role == "Specialist")
    {
        <div class="stat-grid">
            <div class="stat-card" style="--stat-color:#6366f1;--stat-bg:#eef2ff">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Dự thảo của tôi</div>
                    <div class="stat-value">@_stats?.TodayDocuments</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#f59e0b;--stat-bg:#fffbeb">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chờ phê duyệt</div>
                    <div class="stat-value">@_stats?.PendingDocuments</div>
                </div>
            </div>
        </div>
    }
    else if (_role == "Manager")
    {
        <div class="stat-grid">
            <div class="stat-card" style="--stat-color:#8b5cf6;--stat-bg:#ede9fe">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chờ ký nháy</div>
                    <div class="stat-value">@_stats?.PendingDocuments</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#10b981;--stat-bg:#ecfdf5">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Đã phân công</div>
                    <div class="stat-value">@_stats?.TotalDocuments</div>
                </div>
            </div>
        </div>
    }
    else if (_role == "BoardOfDirectors")
    {
        <div class="stat-grid">
            <div class="stat-card" style="--stat-color:#ef4444;--stat-bg:#fef2f2">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chờ ký số pháp nhân</div>
                    <div class="stat-value">@_stats?.PendingDocuments</div>
                </div>
            </div>
            <div class="stat-card" style="--stat-color:#10b981;--stat-bg:#ecfdf5">
                <div class="stat-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Đã ký ban hành</div>
                    <div class="stat-value">@_stats?.PublishedDocuments</div>
                </div>
            </div>
        </div>
    }

    <div style="display:grid;grid-template-columns:1fr;gap:20px;margin-top:8px;">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Thao tác nhanh</span>
            </div>
            <div class="card-body" style="display:flex;gap:12px;flex-wrap:wrap;">
                <a href="/documents" class="btn btn-outline">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    Xem tất cả công văn
                </a>
                <AuthorizeView Roles="Clerk,Specialist">
                    <a href="/documents/create" class="btn btn-primary">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        Tạo công văn mới
                    </a>
                </AuthorizeView>
                <AuthorizeView Roles="Manager,BoardOfDirectors">
                    <a href="/signatures" class="btn btn-primary">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                        Ký số tài liệu
                    </a>
                </AuthorizeView>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string? _userName;
    private string? _role;
    private DashboardStats? _stats;

    protected override async Task OnInitializedAsync()
    {
        _userName = await AuthService.GetUserNameAsync();
        _role = await AuthService.GetRoleAsync();

        try { _stats = await AdminService.GetStatsAsync(); }
        catch { _stats = new DashboardStats { TotalUsers = 0, TotalDocuments = 0, PendingDocuments = 0, PublishedDocuments = 0, TodayDocuments = 0 }; }

        _isLoading = false;
    }
}
