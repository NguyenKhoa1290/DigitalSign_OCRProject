@page "/documents/create"
@attribute [Authorize(Roles = "Clerk,Specialist")]
@inject DocumentService DocumentService
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>Tạo Công văn mới - HAU</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Tạo Công văn mới</h1>
        <p class="page-subtitle">Điền thông tin và đính kèm PDF hoặc ảnh công văn</p>
    </div>
    <div class="page-actions">
        <a href="/documents" class="btn btn-outline">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Quay lại
        </a>
    </div>
</div>

<div class="create-layout">
    <div class="card create-information-card">
        <div class="card-header">
            <span class="card-title">Thông tin Công văn</span>
        </div>
        <div class="card-body">
            <EditForm Model="_model" OnValidSubmit="HandleCreate">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label required">Tiêu đề</label>
                    <input type="text" class="form-control" placeholder="Nhập tiêu đề công văn..."
                           @bind="_model.Title" @bind:event="oninput" />
                </div>

                <div class="create-form-grid">
                    <div class="form-group">
                        <label class="form-label">Số hiệu văn bản (có thể bổ sung sau)</label>
                        <input type="text" class="form-control" placeholder="VD: 01/2024/QĐ-HAU"
                               @bind="_model.DocumentNumber" @bind:event="oninput" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ngày ban hành (có thể bổ sung sau)</label>
                        <input type="date" class="form-control"
                               @bind="_issuedDate" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="document-type-select">Loại văn bản</label>
                    <CustomSelect Id="document-type-select" @bind-Value="_selectedTypeId" Options="DocumentTypeOptions" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <div class="create-actions">
                    <a href="/documents" class="btn btn-outline">Hủy</a>
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <div class="spinner spinner-sm create-spinner"></div>
                            <span>Đang tạo...</span>
                        }
                        else
                        {
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Tạo Công văn</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Tải lên PDF hoặc ảnh</span>
        </div>
        <div class="card-body">
            <div class="file-upload-area" @onclick="TriggerFileInput">
                <div class="file-upload-icon">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                </div>
                <div class="file-upload-text">
                    @if (_selectedFile != null)
                    {
                        <strong class="file-emphasis">@_selectedFile.Name</strong>
                        <br /><small>@(_selectedFile.Size / 1024) KB</small>
                    }
                    else
                    {
                        <span>Chọn PDF hoặc ảnh để đính kèm công văn.</span>
                    }
                </div>
                <button type="button" class="btn btn-primary pdf-picker-button"
                        @onclick="TriggerFileInput" @onclick:stopPropagation>
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m-4 4 4-4 4 4M4 16v4h16v-4" />
                    </svg>
                    @(_selectedFile == null ? "Chọn file" : "Đổi file")
                </button>
                <div class="file-upload-hint">PDF, PNG, JPG/JPEG hoặc WEBP (tối đa 50 MB). OCR tối đa 5 trang mỗi lượt.</div>
            </div>
            <div class="file-input-wrapper" hidden>
                <InputFile id="fileInput" OnChange="OnFileSelected" accept="@DocumentFileFormats.Accept" />
            </div>

            @if (_selectedFile != null)
            {
                <div class="file-ready">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#10b981" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="file-ready-text">File sẵn sàng tải lên</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly CreateDocumentDto _model = new();
    private List<DocumentTypeDto>? _documentTypes;
    private string _selectedTypeId = "";
    private IReadOnlyList<SelectOption> DocumentTypeOptions
    {
        get
        {
            var options = new List<SelectOption> { new("", "Chọn loại văn bản") };
            if (_documentTypes != null)
                options.AddRange(_documentTypes.Select(type => new SelectOption(type.Id.ToString(), type.DisplayName)));
            return options;
        }
    }
    private DateOnly? _issuedDate;
    private IBrowserFile? _selectedFile;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _documentTypes = await DocumentService.GetDocumentTypesAsync();
        if (await AuthService.GetRoleAsync() == "Specialist")
            _documentTypes = _documentTypes?.Where(type => type.TypeName != "CongVanDen").ToList();
    }

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(_model.Title) || !Guid.TryParse(_selectedTypeId, out var selectedType))
        {
            _errorMessage = "Vui lòng nhập tiêu đề và chọn loại văn bản.";
            return;
        }

        _isSubmitting = true;

        if (_selectedFile?.Size > 52428800)
        {
            _errorMessage = "File vượt quá giới hạn 50 MB. Vui lòng chọn file nhỏ hơn.";
            _isSubmitting = false;
            return;
        }
        _errorMessage = null;

        _model.DocumentTypeId = selectedType;
        _model.IssuedDate = _issuedDate;

        try
        {
            var created = await DocumentService.CreateDocumentAsync(_model);
            if (created == null)
            {
                _errorMessage = "Tạo công văn thất bại.";
                _isSubmitting = false;
                return;
            }

            // Upload file if selected
            if (_selectedFile != null)
            {
                try
                {
                    using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 52428800);
                    if (await DocumentService.UploadFileAsync(created.Id, stream, _selectedFile.Name) is null)
                        throw new InvalidOperationException("API chưa xác nhận tải file thành công.");
                }
                catch (Exception ex)
                {
                    var reason = ex is HttpRequestException ? ex.Message : "Không tải được file.";
                    Toast.ShowWarning($"Công văn đã tạo nhưng file chưa tải lên. {reason} Hãy tải lại tại trang chi tiết.");
                    NavManager.NavigateTo($"/documents/{created.Id}");
                    return;
                }
            }

            Toast.ShowSuccess("Tạo công văn thành công!");
            NavManager.NavigateTo($"/documents/{created.Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi: {ex.Message}";
            _isSubmitting = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = null;
        _errorMessage = null;
        if (DocumentFileFormats.GetContentType(e.File.Name) is null)
            _errorMessage = "Chỉ hỗ trợ PDF, PNG, JPG/JPEG hoặc WEBP.";
        else if (e.File.Size > 52428800)
            _errorMessage = "File vượt quá giới hạn 50 MB.";
        else _selectedFile = e.File;
    }
    private async Task TriggerFileInput() => await JS.InvokeVoidAsync("documentFiles.pickFile", "fileInput");
}
