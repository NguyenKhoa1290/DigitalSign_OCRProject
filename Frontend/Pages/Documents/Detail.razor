    private void OpenDeleteDialog() { _deleteError = null; _showDeleteDialog = true; }
    private void CloseDeleteDialog() { if (!_isActionLoading) _showDeleteDialog = false; }
    private async Task DeleteDraft(string reason)
    {
        if (_isActionLoading || !CanDeleteDraft) return;
        _isActionLoading = true;
        try
        {
            await DocumentService.DeleteDraftAsync(Id, reason);
            _showDeleteDialog = false;
            Toast.ShowSuccess("Đã xóa mềm bản nháp.");
            NavManager.NavigateTo("/documents");
        }
        catch (HttpRequestException ex)
        {
            _deleteError = ex.Message;
            await LoadDocument();
        }
        catch { _deleteError = "Không xóa được công văn. Hãy thử lại."; }
        finally { _isActionLoading = false; }
    }
