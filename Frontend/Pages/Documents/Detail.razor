@page "/documents/{Id:guid}"
@attribute [Authorize]
@inject DocumentService DocumentService
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject IToastService Toast
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AdminService AdminService
@inject NotificationRealtimeService Realtime
@implements IAsyncDisposable

<PageTitle>@(_document?.Title ?? "Chi tiết Công văn") - HAU</PageTitle>

@if (_isLoading)
{
    <LoadingSpinner Message="Đang tải thông tin công văn..." />
}
else if (_document == null)
{
    <div class="empty-state">
        <p class="empty-state-title">Không tìm thấy công văn</p>
        <a href="/documents" class="btn btn-primary empty-back-button">Quay lại danh sách</a>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title document-title">@_document.Title</h1>
            <div class="document-meta">
                <StatusBadge Status="@_document.Status" />
                @if (!string.IsNullOrEmpty(_document.DocumentNumber))
                {
                    <span class="document-number">Số: @_document.DocumentNumber</span>
                }
            </div>
        </div>
        <div class="page-actions">
            <a href="/documents" class="btn btn-outline">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Quay lại
            </a>
        </div>
    </div>

    <!-- Action Buttons by Role/Status -->
    <div class="document-actions">
        @if (CanDeleteDraft)
        {
            <button class="btn btn-danger" @onclick="OpenDeleteDialog" disabled="@_isActionLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M6 18L18 6" /></svg>
                Xóa bản nháp
            </button>
        }
        @if (_canReceive && _document.DocTypeName == "CongVanDen" && _document.Status == "Draft" && _document.OfficiallyReceivedAt == null)
        {
            <button class="btn btn-outline" @onclick='() => ShowActionModal("receive")' disabled="@_isActionLoading">Tiếp nhận chính thức</button>
        }
        @if (CanEdit)
        {
            <button class="btn btn-outline" @onclick="OpenEditModal" disabled="@_isActionLoading">Sửa thông tin</button>
        }
        @if (CanAssign)
        {
            <button class="btn btn-outline" @onclick="OpenAssignModal" disabled="@_isActionLoading">Phân công xử lý</button>
        }
        @if (!string.IsNullOrWhiteSpace(_document.MinioPath))
        {
            <button class="btn btn-outline" @onclick="DownloadFile" disabled="@(_isActionLoading || _fileUrl == null)">@(IsWordFile ? "Tải Word" : IsImageFile ? "Tải ảnh" : "Tải PDF")</button>
        }
        @if (IsIncoming && _document.Status == "Draft" && _role == "Clerk")
        {
            <button type="button" class="btn btn-primary" @onclick='() => ShowActionModal("incoming-submit")'
                    disabled="@(_isActionLoading || _document.MinioPath?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) != true)">Trình BGH chỉ đạo</button>
        }
        @if (IsIncoming && _document.Status == "PendingDirection" && _role == "BoardOfDirectors")
        {
            <button type="button" class="btn btn-primary" @onclick="OpenDirectionModal" disabled="@_isActionLoading">Ký chỉ đạo</button>
        }
        @if (CanEdit)
        {
            @if (CanSubmitOutgoing)
            {
            <button class="btn btn-primary" @onclick='() => ShowActionModal("submit")' disabled="@_isActionLoading">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                Nộp trình duyệt
            </button>
            }
            <button type="button" class="btn btn-outline" @onclick="ChoosePdf" disabled="@_isActionLoading">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                Tải lên file
            </button>
            <div class="hidden-file-input" hidden>
                <InputFile id="documentPdfInput" OnChange="OnFileUpload" accept="@DocumentFileFormats.Accept" disabled="@_isActionLoading" />
            </div>
        }
            @if (CanOperateOcr && !IsWordFile)
            {
                <button class="btn btn-outline" @onclick="RunOcr" disabled="@(_isActionLoading || _ocrJob?.IsActive == true)">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />
                    </svg>
                    Chạy OCR
                </button>
            }

        @if (!IsIncoming && _document.Status == "PendingDeptReview" && _role == "Manager")
        {
            <button class="btn btn-success" @onclick='() => ShowActionModal("dept-sign")'>
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                Ký nháy
            </button>
            <button class="btn btn-danger" @onclick='() => ShowActionModal("reject")'>
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Từ chối
            </button>
        }

        @if (!IsIncoming && _document.Status == "DeptSigned" && _role == "Manager")
        {
            <button class="btn btn-primary" @onclick='() => ShowActionModal("submit-director")'>
                Trình BGH ký
            </button>
        }

        @if (!IsIncoming && (_document.Status == "PendingDirectorSign" || _document.Status == "DeptSigned") && _role == "BoardOfDirectors")
        {
            <button class="btn btn-success" @onclick='() => ShowActionModal("director-sign")'>
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
                Ký số pháp nhân
            </button>
            <button class="btn btn-danger" @onclick='() => ShowActionModal("reject")'>Từ chối</button>
        }

        @if (!IsIncoming && _document.Status == "DirectorSigned" && (_role == "Clerk" || _role == "Admin"))
        {
            <button class="btn btn-success" @onclick="() => PublishDocument()">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Ban hành
            </button>
        }

        @if ((_role == "Manager" || _role == "BoardOfDirectors" || _role == "Admin") && (_document.Status != "Draft" || _role == "Admin"))
        {
            <a href="/signatures/@_document.Id" class="btn btn-outline">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                Xem Chữ ký
            </a>
        }

        @if (!IsWordFile)
        {
        <button type="button" class="btn btn-outline" @onclick="ShowOcrResult">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />
            </svg>
            Kết quả OCR
        </button>
        }
    </div>

    @if (IsIncoming && _document.Status == "Draft" && _role == "Clerk" && _document.MinioPath?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) != true)
    {
        <p class="form-hint">Tải bản PDF trước khi trình lãnh đạo ký. Ảnh vẫn có thể dùng để OCR.</p>
    }
    @if (IsIncoming && _document.Status is "PendingDeptReview" or "DeptSigned" or "PendingDirectorSign" or "DirectorSigned" or "Published" or "Rejected")
    {
        <p class="alert alert-warning" role="status">Hồ sơ công văn đến này đang có trạng thái của quy trình cũ. Cần đối soát trước khi chuyển sang quy trình mới.</p>
    }

    <div class="document-detail-layout">
        <div class="document-detail-column">
            <!-- Document Info -->
            <div class="card">
                <div class="card-header"><span class="card-title">Thông tin Công văn</span></div>
                <div class="card-body">
                    <div class="detail-grid">
                        <div class="detail-item">
                            <div class="detail-label">Loại văn bản</div>
                            <div class="detail-value">@(_document.DocumentTypeDisplayName ?? "—")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Số hiệu</div>
                            <div class="detail-value">@(_document.DocumentNumber ?? "—")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Ngày ban hành</div>
                            <div class="detail-value">@(_document.IssuedDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Phòng ban</div>
                            <div class="detail-value">@(_document.DepartmentName ?? "—")</div>
                        </div>
                        @if (IsIncoming && _document.ProcessingDepartmentId.HasValue)
                        {
                            <div class="detail-item"><div class="detail-label">Đơn vị xử lý</div><div class="detail-value">@_document.ProcessingDepartmentName</div></div>
                        }
                        @if (IsIncoming && _document.AssignedToId.HasValue)
                        {
                            <div class="detail-item"><div class="detail-label">Chuyên viên được phân công</div><div class="detail-value">@_document.AssignedToName</div></div>
                        }
                        <div class="detail-item">
                            <div class="detail-label">Người tạo</div>
                            <div class="detail-value">@(_document.CreatedByName ?? "—")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Ngày tạo</div>
                            <div class="detail-value">@VietnamTime.Format(_document.CreatedAt)</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (_pendingImageUrl != null)
            {
                <div class="card pending-image-card document-preview-card">
                    <div class="card-header"><span class="card-title">Xem trước ảnh vừa chọn</span><span class="badge">Chưa lưu</span></div>
                    <div class="card-body">
                        <img class="document-image pending-document-image" src="@_pendingImageUrl" alt="@_pendingFileName" />
                        <p class="form-hint" role="status">@(_pendingUploadError ?? "Đang tải ảnh lên. Ảnh chỉ được lưu sau khi máy chủ xác nhận thành công.")</p>
                    </div>
                </div>
            }
            <!-- Saved file viewer -->
            @if (!string.IsNullOrEmpty(_fileUrl))
            {
                <div class="card @(IsWordFile ? "" : "document-preview-card")">
                    <div class="card-header">
                        <span class="card-title">@(IsWordFile ? "Văn bản Word" : IsImageFile ? "Xem ảnh công văn" : "Xem File PDF")</span>
                        @if (!IsWordFile)
                        {
                        <a href="@_fileUrl" target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                            Mở trong tab mới
                        </a>
                        }
                    </div>
                    <div class="card-body @(IsWordFile ? "" : "pdf-card-body")">
                        @if (IsWordFile)
                        {
                            <p>@_document.FileName</p>
                            <p class="form-hint">Đây là tệp văn bản hoàn chỉnh, không cần OCR. Tải Word để mở trên máy. Khi cần ký số, xuất PDF và tải lại.</p>
                        }
                        else if (IsImageFile)
                        {
                            @if (_imageDisplayUrl != null)
                            {
                                <img class="document-image" src="@_imageDisplayUrl" alt="@(_document.FileName ?? _document.Title)" />
                            }
                            else
                            {
                                <p class="form-hint" role="status">Không tạo được ảnh xem trước. Bạn có thể tải ảnh gốc để xem.</p>
                            }
                        }
                        else
                        {
                            <iframe class="pdf-frame" src="@_fileUrl" title="Nội dung PDF công văn"></iframe>
                        }
                    </div>
                </div>
            }
            else if (_fileError != null)
            {
                <div class="alert alert-warning" role="alert">@_fileError</div>
            }
            else if (_pendingImageUrl == null && string.IsNullOrWhiteSpace(_document.MinioPath))
            {
                <div class="card">
                    <div class="card-header"><span class="card-title">Tệp đính kèm</span></div>
                    <div class="card-body">
                        <p>Chưa có tệp đính kèm được lưu cho công văn này.</p>
                        @if (CanEdit)
                        {
                            <p class="form-hint">Chọn ảnh hoặc PDF để xem trước và tải lên.</p>
                            <button class="btn btn-outline" disabled="@_isActionLoading" @onclick="ChoosePdf">Chọn tệp đính kèm</button>
                        }
                    </div>
                </div>
            }

            @if (!IsWordFile)
            {
                @if (CanOperateOcr && _showGeminiOcr)
                {
                    var operationId = _ocrOperationId;
                    var documentId = Id;
                    var expectedVersion = _ocrExpectedVersion;
                    <div id="document-gemini-ocr">
                        <GeminiOcrPanel @key="operationId" CaptureResult="true"
                            AttachedDocumentId="documentId" AttachedVersion="expectedVersion" AttachedFileName="@(_document.FileName ?? _document.MinioObjectName)"
                            OnQueued="@(job => OcrQueued(documentId, operationId, job))"
                            BusyChanged="@(busy => SetOcrBusy(documentId, operationId, busy))" />
                    </div>
                }
                @if (_ocrJob?.IsActive == true)
                {
                    <div class="alert alert-info" role="status">@(_ocrJob.Status == "Queued" ? "Đã xếp hàng OCR." : "Đang nhận diện OCR.") Bạn có thể tiếp tục thao tác hoặc rời trang. Hệ thống sẽ thông báo khi hoàn tất hoặc có lỗi.</div>
                }
                else if (_ocrJob?.Status == "Failed")
                {
                    <div class="alert alert-danger" role="alert">OCR không thành công. @_ocrJob.Error Bạn có thể chọn model khác và chạy lại.</div>
                }
                var resultDocumentId = Id;
                <GeminiOcrResultView Result="_geminiResult" IsIncoming="IsIncoming" DocumentStatus="@_document.Status" CreatedById="_document.CreatedById" IsProcessing="@(_ocrJob?.IsActive == true)"
                    DocumentId="Id" ExpectedVersion="_document.ConcurrencyVersion" SourcePath="@_document.MinioPath" IsBusy="_isActionLoading"
                    OnEdited="@(() => OcrEdited(resultDocumentId))" BusyChanged="@(busy => SetEditedBusy(resultDocumentId, busy))" />
            }
        </div>

        <div class="document-detail-column">
            <!-- Signatures -->
            @if (_document.Signatures.Any())
            {
                <div class="card">
                    <div class="card-header"><span class="card-title">Chữ ký (@_document.Signatures.Count)</span></div>
                    <div class="card-body">
                        @foreach (var sig in _document.Signatures)
                        {
                            <div class="sig-item">
                                <div class="sig-icon">
                                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                    </svg>
                                </div>
                                <div class="sig-info">
                                    <div class="sig-name">@sig.SignerName</div>
                                    <div class="sig-meta">@sig.SignatureType • @VietnamTime.Format(sig.SignedAt)</div>
                                    @if (sig.IsValid) { <span class="sig-valid">✓ Hợp lệ</span> }
                                    else { <span class="sig-invalid">✗ Không hợp lệ</span> }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Process History -->
            @if (_document.ProcessHistory.Any())
            {
                <div class="card">
                    <div class="card-header"><span class="card-title">Lịch sử xử lý</span></div>
                    <div class="card-body">
                        <div class="timeline">
                            @foreach (var proc in _document.ProcessHistory.OrderByDescending(p => p.ProcessedAt))
                            {
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-time">@VietnamTime.Format(proc.ProcessedAt)</div>
                                    <div class="timeline-title">@GetActionLabel(proc.Action)</div>
                                    <div class="timeline-desc">
                                        @proc.ProcessedByName
                                        @if (!string.IsNullOrEmpty(proc.Comment))
                                        {
                                            <span>: "@proc.Comment"</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Action Modal -->
<DocumentDeletionDialog IsVisible="_showDeleteDialog" DocumentTitle="@(_document?.Title ?? "")" RequireReason="_isAdmin"
                        Busy="_isActionLoading" Error="@_deleteError" OnConfirm="DeleteDraft" OnCancel="CloseDeleteDialog" />
@if (_showEditModal)
{
    <div class="modal-overlay">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Sửa thông tin công văn">
            <div class="modal-header">
                <span class="modal-title">Sửa thông tin công văn</span>
                <button class="modal-close" @onclick="() => _showEditModal = false" disabled="@_isActionLoading" aria-label="Đóng">&times;</button>
            </div>
            <div class="modal-body">
                @if (_formError != null) { <div class="alert alert-danger" role="alert">@_formError</div> }
                <div class="form-group">
                    <label class="form-label" for="edit-title">Tiêu đề</label>
                    <input id="edit-title" class="form-control" maxlength="500" @bind="_editModel.Title" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-number">Số hiệu</label>
                    <input id="edit-number" class="form-control" maxlength="50" @bind="_editModel.DocumentNumber" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-type">Loại văn bản</label>
                    <CustomSelect Id="edit-type" AriaLabel="Loại văn bản" Options="EditTypeOptions" @bind-Value="_editTypeId" MaxOptionsHeight="160" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-date">Ngày ban hành</label>
                    <InputDate id="edit-date" class="form-control" @bind-Value="_editModel.IssuedDate" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="() => _showEditModal = false" disabled="@_isActionLoading">Hủy</button>
                <button class="btn btn-primary" @onclick="SaveEdit" disabled="@_isActionLoading">Lưu thay đổi</button>
            </div>
        </div>
    </div>
}
@if (_showAssignModal)
{
    <div class="modal-overlay">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Phân công xử lý">
            <div class="modal-header">
                <span class="modal-title">@(IsIncoming ? "Ký phân công chuyên viên" : "Phân công xử lý")</span>
                <button class="modal-close" @onclick="() => _showAssignModal = false" disabled="@_isActionLoading" aria-label="Đóng">&times;</button>
            </div>
            <div class="modal-body">
                @if (_formError != null) { <div class="alert alert-danger" role="alert">@_formError</div> }
                <div class="form-group">
                    <label class="form-label" for="assignee-search">Tìm người nhận</label>
                    <div class="assignee-search-row">
                        <input id="assignee-search" class="form-control" placeholder="Họ tên hoặc tài khoản" @bind="_assigneeSearch" @bind:event="oninput" @bind:after="ClearAssignee" />
                        <button class="btn btn-outline" @onclick="SearchAssignees" disabled="@_isSearching">Tìm</button>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="assignee-select">Người nhận</label>
                    <CustomSelect Id="assignee-select" AriaLabel="Người nhận" Options="AssigneeOptions" @bind-Value="_assigneeId" MaxOptionsHeight="160" Disabled="@_isSearching" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="assign-comment">@(IsIncoming ? "Ý kiến phân công (bắt buộc)" : "Ghi chú")</label>
                    <textarea id="assign-comment" class="form-control" rows="3" maxlength="1000" @bind="_assignComment" disabled="@_isActionLoading"></textarea>
                    @if (IsIncoming) { <p class="form-hint">Ký số ý kiến phân công trên bản PDF đã có chữ ký chỉ đạo của Ban Giám hiệu.</p> }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="() => _showAssignModal = false" disabled="@_isActionLoading">Hủy</button>
                <button class="btn btn-primary" @onclick="SaveAssignment" disabled="@(_isActionLoading || _isSearching || string.IsNullOrEmpty(_assigneeId))">@(_isActionLoading ? "Đang xử lý..." : IsIncoming ? "Ký và phân công" : "Xác nhận phân công")</button>
            </div>
        </div>
    </div>
}
@if (_showDirectionModal)
{
    <div class="modal-overlay">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Ký chỉ đạo công văn đến">
            <div class="modal-header"><span class="modal-title">Ký chỉ đạo công văn đến</span>
                <button type="button" class="modal-close" aria-label="Đóng" disabled="@_isActionLoading" @onclick="() => _showDirectionModal = false">&times;</button></div>
            <div class="modal-body">
                @if (_formError != null) { <div class="alert alert-danger" role="alert">@_formError</div> }
                <div class="form-group"><label class="form-label" for="incoming-department">Đơn vị xử lý</label>
                    <CustomSelect Id="incoming-department" AriaLabel="Đơn vị xử lý" Options="DirectionDepartmentOptions" @bind-Value="_directionDepartmentId" Disabled="@_isActionLoading" MaxOptionsHeight="180" /></div>
                <div class="form-group"><label class="form-label" for="incoming-comment">Ý kiến chỉ đạo (bắt buộc)</label>
                    <textarea id="incoming-comment" class="form-control" rows="4" maxlength="1000" @bind="_directionComment" disabled="@_isActionLoading"></textarea></div>
                <p class="form-hint">Chữ ký số ghi nhận ý kiến chỉ đạo và đơn vị nhận. Chỉ chuyển đơn vị sau khi ký thành công.</p>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline" disabled="@_isActionLoading" @onclick="() => _showDirectionModal = false">Hủy</button>
                <button type="button" class="btn btn-primary" disabled="@_isActionLoading" @onclick="SaveDirection">@(_isActionLoading ? "Đang ký..." : "Ký và chuyển đơn vị")</button></div>
        </div>
    </div>
}
@if (_showActionModal)
{
    <div class="modal-overlay" @onclick="CloseActionModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">@GetActionModalTitle()</span>
                <button class="modal-close" @onclick="CloseActionModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label" for="workflow-action-comment">Ghi chú (tùy chọn)</label>
                    <textarea id="workflow-action-comment" class="form-control" placeholder="Nhập ghi chú..." @bind="_actionComment" rows="3"
                              aria-describedby="@(_currentAction == "receive" ? "receive-action-note" : null)"></textarea>
                    @if (_currentAction == "receive")
                    {
                        <p id="receive-action-note" class="form-hint">Sau khi tiếp nhận chính thức, công văn không được xóa.</p>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseActionModal">Hủy</button>
                <button class="btn @GetActionButtonClass()" @onclick="ExecuteAction" disabled="@_isActionLoading">
                    @if (_isActionLoading)
                    {
                        <div class="spinner spinner-sm action-spinner"></div>
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <span>@(_currentAction == "receive" ? "Xác nhận tiếp nhận" : GetActionModalTitle())</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DocumentDto? _document;
    private bool _isLoading = true;
    private bool _isActionLoading;
    private bool _showDeleteDialog, _isAdmin, _hasDeleteRole, _canReceive;
    private Guid _actorId;
    private string? _deleteError;
    private bool CanDeleteDraft => _document?.CanDeleteDraft == true && _hasDeleteRole
        && (_isAdmin || _document.CreatedById == _actorId);
    private string? _role;
    private Guid? _actorDepartmentId;
    private bool IsIncoming => _document?.DocTypeName == "CongVanDen";
    private bool CanAssign => IsIncoming
        ? _role == "Manager" && _document?.Status == "PendingAssignment" && _actorDepartmentId.HasValue && _actorDepartmentId == _document.ProcessingDepartmentId
        : _role is "Admin" or "Manager" or "BoardOfDirectors";
    private bool _showDirectionModal;
    private string _directionDepartmentId = "", _directionComment = "";
    private List<DepartmentDto> _directionDepartments = new();
    private IReadOnlyList<SelectOption> DirectionDepartmentOptions => new[] { new SelectOption("", "Chọn đơn vị xử lý") }
        .Concat(_directionDepartments.Select(d => new SelectOption(d.Id.ToString(), $"{d.DeptName} ({d.DeptCode})"))).ToList();
    private string? _fileUrl, _imageDisplayUrl;
    private string? _fileError;
    private string? _pendingImageUrl, _pendingFileName, _pendingUploadError;
    private Guid _loadedDocumentId;
    private bool _disposed;
    private bool _showEditModal, _showAssignModal, _isSearching;
    private string? _formError;
    private UpdateDocumentDto _editModel = new();
    private string _editTypeId = "", _assigneeSearch = "", _assigneeId = "", _assignComment = "";
    private List<DocumentTypeDto> _documentTypes = new();
    private List<AssigneeDto> _assignees = new();
    private bool CanEdit => _document != null && (IsIncoming ? _document.Status == "Draft" : _document.Status is "Draft" or "Rejected")
        && (_isAdmin || (IsIncoming ? _canReceive : _canDraftOutgoing && _document.CreatedById == _actorId));
    private bool CanOperateOcr => _isAdmin || _canReceive && _document?.Status is "Draft" or "Rejected";
    private bool CanSubmitOutgoing => !IsIncoming && _document?.Status is "Draft" or "Rejected"
        && (_isAdmin || (_canDraftOutgoing && _document.CreatedById == _actorId));
    private bool _canDraftOutgoing;
    private bool IsImageFile => _document?.FileContentType?.StartsWith("image/", StringComparison.Ordinal) == true;
    private bool IsWordFile => _document?.FileContentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
    private IReadOnlyList<SelectOption> EditTypeOptions => _documentTypes.Select(type => new SelectOption(type.Id.ToString(), type.DisplayName)).ToList();
    private IReadOnlyList<SelectOption> AssigneeOptions => new[] { new SelectOption("", "Chọn người nhận") }
        .Concat(_assignees.Select(user => new SelectOption(user.Id.ToString(), $"{user.FullName} ({user.Username}) — {user.DepartmentName}"))).ToList();

    private bool _showActionModal;
    private string _currentAction = "";
    private string _actionComment = "";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedDocumentId != Id) { _documentWatchStop?.Cancel(); _documentWatchStop?.Dispose(); _documentWatchStop = new(); Realtime.WatchDocument(null); _ocrPollStop?.Cancel(); _ocrPollTask = null; await ReleasePendingImage(); _pendingUploadError = null; _showGeminiOcr = false; _isActionLoading = false; _ocrOperationId = Guid.NewGuid(); _loadedDocumentId = Id; }
        _role = await AuthService.GetRoleAsync();
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _isAdmin = user.IsInRole("Admin");
        _canDraftOutgoing = user.IsInRole("Specialist");
        _hasDeleteRole = _isAdmin || user.IsInRole("Clerk") || user.IsInRole("Specialist");
        _canReceive = _isAdmin || user.IsInRole("Clerk");
        Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value, out _actorId);
        await LoadDocument();
    }

    private async Task LoadDocument()
    {
        _isLoading = true;
        _document = await DocumentService.GetDocumentAsync(Id);
        Realtime.WatchDocument(_document?.Id);
        _geminiResult = GeminiOcrResult.Parse(_document?.OcrDataRaw);
        _ocrJob = CanOperateOcr && !IsWordFile && !string.IsNullOrWhiteSpace(_document?.MinioPath) ? await DocumentService.GetLatestOcrJobAsync(Id) : null;
        _observedOcrState = _ocrJob == null ? "" : $"{_ocrJob.Id}:{_ocrJob.Status}";
        if (IsIncoming && _role == "Manager")
            _actorDepartmentId = (await AdminService.GetUserAsync(_actorId))?.DepartmentId;
        if (_imageDisplayUrl != null) await JS.InvokeVoidAsync("documentFiles.releaseUrl", _imageDisplayUrl);
        _imageDisplayUrl = null;
        if (_fileUrl != null) await JS.InvokeVoidAsync("documentFiles.releaseUrl", _fileUrl);
        _fileUrl = null;
        _fileError = null;
        if (!string.IsNullOrWhiteSpace(_document?.MinioPath))
        {
            try
            {
                var bytes = await DocumentService.GetFileAsync(Id);
                if (bytes == null) _fileError = "Không tải được file. Vui lòng tải lại trang hoặc liên hệ quản trị viên.";
                else if (!_disposed)
                {
                    _fileUrl = await JS.InvokeAsync<string>("documentFiles.createUrl", bytes, _document.FileContentType);
                    if (IsImageFile)
                    {
                        try { _imageDisplayUrl = await JS.InvokeAsync<string>("documentFiles.createImagePreview", _fileUrl); }
                        catch (JSException) { /* Keep the original downloadable file when preview decoding fails. */ }
                    }
                }
            }
            catch { _fileError = "Không tải được file. Vui lòng thử lại."; }
        }
        _isLoading = false;
        EnsureOcrPolling();
        if (new Uri(NavManager.Uri).Fragment == "#document-ocr-result") _scrollTarget = "document-ocr-result";
    }

    private async Task DownloadFile()
    {
        var extension = Path.GetExtension(_document?.MinioPath);
        if (_fileUrl != null) await JS.InvokeVoidAsync("documentFiles.download", _fileUrl,
            string.IsNullOrWhiteSpace(_document?.FileName)
                ? $"cong-van-{Id}{(string.IsNullOrEmpty(extension) ? ".pdf" : extension)}" : _document.FileName);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Realtime.Received -= OcrNotification;
        Realtime.DocumentChanged -= WatchedDocumentChanged;
        Realtime.WatchDocument(null);
        _documentWatchStop?.Cancel(); _documentWatchStop?.Dispose();
        _ocrPollStop?.Cancel(); _ocrPollStop?.Dispose();
        if (_imageDisplayUrl != null) await JS.InvokeVoidAsync("documentFiles.releaseUrl", _imageDisplayUrl);
        if (_fileUrl != null) await JS.InvokeVoidAsync("documentFiles.releaseUrl", _fileUrl);
        await ReleasePendingImage();
    }
    private async Task ReleasePendingImage()
    {
        if (_pendingImageUrl != null) await JS.InvokeVoidAsync("documentFiles.releaseUrl", _pendingImageUrl);
        _pendingImageUrl = null; _pendingFileName = null;
    }

    private async Task OpenEditModal()
    {
        if (_document == null) return;
        _formError = null;
        _documentTypes = await DocumentService.GetDocumentTypesAsync() ?? new();
        if (!_isAdmin) _documentTypes = _documentTypes.Where(type => (type.TypeName == "CongVanDen") == IsIncoming).ToList();
        _editModel = new UpdateDocumentDto { Title = _document.Title, DocumentNumber = _document.DocNumber, DocumentTypeId = _document.DocTypeId, IssuedDate = _document.IssuedDate };
        _editTypeId = _document.DocTypeId?.ToString() ?? "";
        _showEditModal = true;
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editModel.Title) || !Guid.TryParse(_editTypeId, out var typeId))
        { _formError = "Vui lòng nhập tiêu đề và chọn loại văn bản."; return; }
        _isActionLoading = true;
        try
        {
            _editModel.DocumentTypeId = typeId;
            var updated = await DocumentService.UpdateDocumentAsync(Id, _editModel);
            if (updated == null) { _formError = "Không lưu được công văn. Chỉ có thể sửa khi Nháp hoặc Bị từ chối."; return; }
            _showEditModal = false;
            Toast.ShowSuccess("Đã cập nhật công văn.");
            await LoadDocument();
        }
        catch { _formError = "Không lưu được công văn. Vui lòng thử lại."; }
        finally { _isActionLoading = false; }
    }

    private async Task OpenDirectionModal()
    {
        if (_isActionLoading || !IsIncoming || _role != "BoardOfDirectors") return;
        _formError = null;
        _directionDepartmentId = _directionComment = "";
        _showDirectionModal = true;
        try
        {
            var departments = await AdminService.GetDepartmentsAsync();
            _directionDepartments = departments ?? new();
            if (departments == null) _formError = "Không tải được đơn vị xử lý. Hãy thử lại.";
        }
        catch { _formError = "Không tải được đơn vị xử lý. Hãy thử lại."; }
    }

    private async Task SaveDirection()
    {
        if (_isActionLoading || _document == null) return;
        if (!Guid.TryParse(_directionDepartmentId, out var departmentId) || string.IsNullOrWhiteSpace(_directionComment))
        { _formError = "Chọn đơn vị xử lý và nhập ý kiến chỉ đạo."; return; }
        _isActionLoading = true;
        _formError = null;
        try
        {
            await DocumentService.SignIncomingAsync(Id, "direction", new { DepartmentId = departmentId,
                Comment = _directionComment, ExpectedVersion = _document.ConcurrencyVersion });
            _showDirectionModal = false;
            Toast.ShowSuccess("Đã ký chỉ đạo và chuyển đơn vị xử lý.");
            await LoadDocument();
        }
        catch (HttpRequestException ex) { _formError = ex.Message; }
        catch { _formError = "Chưa ký được chỉ đạo. Vui lòng thử lại."; }
        finally { _isActionLoading = false; }
    }

    private async Task OpenAssignModal()
    {
        _formError = null;
        _assigneeSearch = _assigneeId = _assignComment = "";
        _showAssignModal = true;
        await SearchAssignees();
    }

    private void ClearAssignee() { _assigneeId = ""; _assignees.Clear(); }

    private async Task SearchAssignees()
    {
        _isSearching = true;
        _formError = null;
        _assigneeId = "";
        var search = _assigneeSearch;
        try
        {
            var result = await DocumentService.GetAssigneesAsync(search, IsIncoming ? _document?.ProcessingDepartmentId : null);
            if (search != _assigneeSearch) return;
            _assignees = result ?? new();
            if (result == null) _formError = "Không tải được danh sách người nhận.";
            else if (result.Count == 0) _formError = "Không tìm thấy người nhận. Hãy đổi từ khóa tìm kiếm.";
        }
        catch { _formError = "Không tải được danh sách người nhận."; }
        finally { _isSearching = false; }
    }

    private async Task SaveAssignment()
    {
        if (_isActionLoading || _document == null) return;
        if (IsIncoming && string.IsNullOrWhiteSpace(_assignComment)) { _formError = "Nhập ý kiến phân công."; return; }
        if (!Guid.TryParse(_assigneeId, out var userId) || !_assignees.Any(user => user.Id == userId))
        { _formError = "Vui lòng chọn người nhận trong danh sách."; return; }
        _isActionLoading = true;
        try
        {
            if (IsIncoming)
                await DocumentService.SignIncomingAsync(Id, "assignment", new { ToUserId = userId, Comment = _assignComment, ExpectedVersion = _document.ConcurrencyVersion });
            else if (!await DocumentService.AssignDocumentAsync(Id, userId, _assignComment))
            { _formError = "Phân công thất bại. Vui lòng thử lại."; return; }
            _showAssignModal = false;
            Toast.ShowSuccess("Đã phân công xử lý.");
            await LoadDocument();
        }
        catch (HttpRequestException ex) { _formError = ex.Message; }
        catch { _formError = "Phân công thất bại. Vui lòng thử lại."; }
        finally { _isActionLoading = false; }
    }

    private void ShowActionModal(string action)
    {
        _currentAction = action;
        _actionComment = "";
        _showActionModal = true;
    }
    private void CloseActionModal() => _showActionModal = false;

    private async Task ExecuteAction()
    {
        if (_isActionLoading) return;
        _isActionLoading = true;
        if (_currentAction == "incoming-submit" && _document != null)
        {
            try { await DocumentService.SubmitIncomingAsync(Id, _document.ConcurrencyVersion, _actionComment); Toast.ShowSuccess("Đã trình Ban Giám hiệu ký chỉ đạo."); }
            catch (HttpRequestException ex) { Toast.ShowError(ex.Message); }
            finally { _showActionModal = false; _isActionLoading = false; await LoadDocument(); }
            return;
        }
        if (_currentAction == "receive")
        {
            try { await DocumentService.ReceiveDocumentAsync(Id); Toast.ShowSuccess("Đã tiếp nhận chính thức công văn đến."); }
            catch (HttpRequestException ex) { Toast.ShowError(ex.Message); }
            finally { _showActionModal = false; _isActionLoading = false; await LoadDocument(); }
            return;
        }
        bool success = false;

        success = _currentAction switch
        {
            "submit" => await DocumentService.SubmitDocumentAsync(Id, _actionComment),
            "dept-sign" => await DocumentService.DeptSignDocumentAsync(Id, _actionComment),
            "submit-director" => await DocumentService.SubmitDirectorDocumentAsync(Id, _actionComment),
            "director-sign" => await DocumentService.DirectorSignDocumentAsync(Id, _actionComment),
            "reject" => await DocumentService.RejectDocumentAsync(Id, _actionComment),
            _ => false
        };

        _isActionLoading = false;
        _showActionModal = false;

        if (success)
        {
            Toast.ShowSuccess("Thực hiện thành công!");
            await LoadDocument();
        }
        else
        {
            Toast.ShowError("Thao tác thất bại. Vui lòng thử lại.");
        }
    }

    private async Task PublishDocument()
    {
        _isActionLoading = true;
        var success = await DocumentService.PublishDocumentAsync(Id);
        _isActionLoading = false;
        if (success) { Toast.ShowSuccess("Đã ban hành công văn!"); await LoadDocument(); }
        else Toast.ShowError("Ban hành thất bại.");
    }

    private bool _showGeminiOcr;
    private GeminiOcrResult? _geminiResult;
    private string? _scrollTarget;
    private OcrJobDto? _ocrJob;
    private CancellationTokenSource? _ocrPollStop;
    private Task? _ocrPollTask;
    private bool _checkingOcr;
    private string _observedOcrState = "";
    private Guid _ocrExpectedVersion;
    private Guid _ocrOperationId;
    private Task RunOcr()
    {
        if (!CanOperateOcr || IsWordFile || _isActionLoading || _document == null || _ocrJob?.IsActive == true) return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(_document.MinioPath))
        {
            Toast.ShowWarning("Vui lòng tải tệp lên trước khi chạy OCR.");
            return Task.CompletedTask;
        }
        _ocrExpectedVersion = _document.ConcurrencyVersion;
        _ocrOperationId = Guid.NewGuid();
        _showGeminiOcr = true; _scrollTarget = "document-gemini-ocr";
        return Task.CompletedTask;
    }
    private Task SetOcrBusy(Guid documentId, Guid operationId, bool busy)
    {
        if (!_disposed && documentId == Id && operationId == _ocrOperationId) _isActionLoading = busy;
        return Task.CompletedTask;
    }
    private void ShowOcrResult() => _scrollTarget = "document-ocr-result";
    private void SetEditedBusy(Guid documentId, bool busy) { if (!_disposed && documentId == Id) _isActionLoading = busy; }
    private async Task OcrEdited(Guid documentId)
    {
        if (_disposed || documentId != Id) return;
        var updated = await DocumentService.GetDocumentAsync(documentId);
        if (_disposed || documentId != Id || updated == null) return;
        _document = updated; _geminiResult = GeminiOcrResult.Parse(updated.OcrDataRaw);
        Toast.ShowSuccess("Đã lưu bản Word OCR đã chỉnh sửa.");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollTarget == null) return;
        var target = _scrollTarget; _scrollTarget = null;
        await JS.InvokeVoidAsync("documentFiles.scrollToElement", target);
    }
    private CancellationTokenSource? _documentWatchStop;
    private bool _refreshingWatchedDocument;
    private bool _watchedDocumentDirty;
    protected override void OnInitialized()
    {
        Realtime.Received += OcrNotification;
        Realtime.DocumentChanged += WatchedDocumentChanged;
    }
    private void WatchedDocumentChanged(Guid documentId, Guid? version)
    {
        if (_disposed || documentId != Id || _document == null || version == _document.ConcurrencyVersion) return;
        if (!version.HasValue)
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || documentId != Id) return;
                _documentWatchStop?.Cancel(); _watchedDocumentDirty = false;
                _document = null; _geminiResult = null; _ocrJob = null;
                Realtime.WatchDocument(null); StateHasChanged();
            });
            return;
        }
        _watchedDocumentDirty = true;
        _ = InvokeAsync(() => RefreshWatchedDocument(documentId, _documentWatchStop?.Token ?? default));
    }
    private async Task RefreshWatchedDocument(Guid documentId, CancellationToken token)
    {
        if (_refreshingWatchedDocument) return;
        _refreshingWatchedDocument = true;
        try
        {
            while (_watchedDocumentDirty && !_disposed && documentId == Id)
            {
                token.ThrowIfCancellationRequested();
                if (_isLoading || _isActionLoading || _checkingOcr) { await Task.Delay(200, token); continue; }
                _watchedDocumentDirty = false;
                var updated = await DocumentService.GetDocumentAsync(documentId, token);
                token.ThrowIfCancellationRequested();
                if (_disposed || documentId != Id) return;
                if (updated == null) { _watchedDocumentDirty = true; await Task.Delay(1000, token); continue; }
                if (updated.MinioPath != _document?.MinioPath) { await LoadDocument(); continue; }
                var changedOcr = updated.OcrDataRaw != _document?.OcrDataRaw;
                _document = updated; _geminiResult = GeminiOcrResult.Parse(updated.OcrDataRaw);
                if (changedOcr) Toast.ShowInfo("Đã cập nhật kết quả OCR của công văn.");
                // Keep the existing file preview and scroll position; read-only roles never run OCR.
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
        catch { /* The next SSE snapshot will reconcile a temporary disconnect. */ }
        finally
        {
            _refreshingWatchedDocument = false;
            if (_watchedDocumentDirty && !_disposed && documentId != Id)
                _ = InvokeAsync(() => RefreshWatchedDocument(Id, _documentWatchStop?.Token ?? default));
        }
    }
    private Task OcrQueued(Guid documentId, Guid operationId, OcrJobDto job)
    {
        if (_disposed || documentId != Id || operationId != _ocrOperationId) return Task.CompletedTask;
        _ocrJob = job; _observedOcrState = $"{job.Id}:{job.Status}";
        _showGeminiOcr = false; _scrollTarget = "document-ocr-result";
        Toast.ShowInfo("Đã tiếp nhận OCR. Bạn có thể tiếp tục thao tác; hệ thống sẽ thông báo khi xong hoặc có lỗi.");
        EnsureOcrPolling();
        return Task.CompletedTask;
    }
    private void OcrNotification()
    {
        if (!_disposed && _ocrJob?.IsActive == true) _ = InvokeAsync(RefreshOcrJob);
    }
    private void EnsureOcrPolling()
    {
        if (_disposed || _ocrJob?.IsActive != true || _ocrPollTask is { IsCompleted: false }) return;
        _ocrPollStop?.Dispose(); _ocrPollStop = new();
        _ocrPollTask = PollOcrJob(Id, _ocrPollStop.Token);
    }
    private async Task PollOcrJob(Guid documentId, CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && documentId == Id && _ocrJob?.IsActive == true)
            { await Task.Delay(5000, token); await InvokeAsync(RefreshOcrJob); }
        }
        catch (OperationCanceledException) { }
    }
    private async Task RefreshOcrJob()
    {
        if (_disposed || _checkingOcr || _isActionLoading || _refreshingWatchedDocument) return;
        _checkingOcr = true; var documentId = Id;
        try
        {
            var job = await DocumentService.GetLatestOcrJobAsync(documentId, _ocrPollStop?.Token ?? default);
            if (_disposed || documentId != Id || job == null) return;
            var state = $"{job.Id}:{job.Status}";
            if (!job.IsActive && state != _observedOcrState)
            {
                var updated = await DocumentService.GetDocumentAsync(documentId);
                if (_disposed || documentId != Id || updated == null) return;
                if (updated.MinioPath != _document?.MinioPath) { await LoadDocument(); return; }
                _document = updated; _geminiResult = GeminiOcrResult.Parse(updated.OcrDataRaw);
            }
            _ocrJob = job; _observedOcrState = state;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch { /* A temporary disconnect must not replay the OCR request. */ }
        finally { _checkingOcr = false; }
    }

    private async Task ChoosePdf()
    {
        if (CanEdit && !_isActionLoading) await JS.InvokeVoidAsync("documentFiles.pickFile", "documentPdfInput");
    }

    private async Task OnFileUpload(InputFileChangeEventArgs e)
    {
        if (!CanEdit || _isActionLoading) return;
        await ReleasePendingImage(); _pendingUploadError = null;
        var file = e.File;
        if (file.Size > 52428800)
        { Toast.ShowWarning("File vượt quá giới hạn 50 MB."); return; }
        if (DocumentFileFormats.GetContentType(file.Name) is null)
        { Toast.ShowWarning("Chỉ hỗ trợ PDF, Word (.docx), PNG, JPG/JPEG hoặc WEBP."); return; }
        _isActionLoading = true;
        try
        {
            if (DocumentFileFormats.GetContentType(file.Name)?.StartsWith("image/", StringComparison.Ordinal) == true)
            {
                _pendingFileName = file.Name;
                _pendingImageUrl = (await JS.InvokeAsync<string[]>("documentFiles.previewFiles", "documentPdfInput")).FirstOrDefault();
                StateHasChanged();
            }
            var result = await DocumentService.UploadFileAsync(Id, "documentPdfInput", file.Name);
            if (result != null) { await ReleasePendingImage(); Toast.ShowSuccess("Tải file thành công!"); await LoadDocument(); }
            else { _pendingUploadError = "Ảnh chưa được lưu. Hãy chọn tệp và thử tải lại."; Toast.ShowError("Tải file thất bại."); }
        }
        catch (HttpRequestException ex) { _pendingUploadError = $"Ảnh chưa được lưu. {ex.Message}"; Toast.ShowError(ex.Message); }
        catch { _pendingUploadError = "Ảnh chưa được lưu. Hãy chọn tệp và thử tải lại."; Toast.ShowError("Không tải được file. Vui lòng thử lại."); }
        finally
        {
            _isActionLoading = false;
            await JS.InvokeVoidAsync("documentFiles.clearFileInput", "documentPdfInput");
        }
    }

