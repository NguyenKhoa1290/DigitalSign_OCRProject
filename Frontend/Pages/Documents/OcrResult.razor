@page "/documents/{Id:guid}/ocr"
@attribute [Authorize]
@inject DocumentService DocumentService

<PageTitle>Kết quả OCR - HAU</PageTitle>
<div class="page-header">
    <h1 class="page-title">Kết quả OCR</h1>
    <a href="/documents/@Id" class="btn btn-outline">Chi tiết công văn</a>
</div>
@if (_loading) { <LoadingSpinner Message="Đang tải kết quả OCR..." /> }
else if (_document == null) { <p>Không tìm thấy công văn.</p> }
else if (_document.FileContentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document")
{ <div class="card"><div class="card-body">Văn bản Word không cần OCR</div></div> }
else { <GeminiOcrResultView Result="GeminiOcrResult.Parse(_document.OcrDataRaw)" DocumentId="Id" IsIncoming="@(_document.DocTypeName == "CongVanDen")" ExpectedVersion="_document.ConcurrencyVersion" SourcePath="@_document.MinioPath" OnEdited="Reload" /> }

@code {
    [Parameter] public Guid Id { get; set; }
    private DocumentDto? _document;
    private bool _loading = true;
    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _document = await DocumentService.GetDocumentAsync(Id); _loading = false;
    }
    private async Task Reload() { _document = await DocumentService.GetDocumentAsync(Id); }
}
