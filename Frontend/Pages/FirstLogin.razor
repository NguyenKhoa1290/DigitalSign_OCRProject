@page "/first-login"
@layout EmptyLayout
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject IToastService Toast

<PageTitle>Đổi mật khẩu lần đầu - HAU Công văn</PageTitle>

<div class="login-page">
    <div class="login-card" style="max-width:480px;">
        <div class="login-logo">
            <div class="login-logo-icon" style="background:linear-gradient(135deg,#1e3a5f,#2563eb);">
                <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
            </div>
            <div class="login-logo-text">
                <h1>HAU Documents</h1>
                <p>Thiết lập mật khẩu lần đầu</p>
            </div>
        </div>

        <div style="background:#fef9c3;border:1px solid #fde047;border-radius:var(--radius-md);
                    padding:12px 16px;margin-bottom:20px;display:flex;gap:10px;align-items:flex-start;">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#ca8a04" stroke-width="2" style="flex-shrink:0;margin-top:2px;">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div style="font-size:13.5px;color:#854d0e;">
                <strong>Yêu cầu bảo mật:</strong> Đây là lần đăng nhập đầu tiên của bạn.
                Vui lòng đặt mật khẩu mới trước khi sử dụng hệ thống.
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="login-error">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                @_errorMessage
            </div>
        }

        @if (_success)
        {
            <div style="background:#dcfce7;border:1px solid #86efac;border-radius:var(--radius-md);
                        padding:14px 16px;text-align:center;color:#166534;margin-bottom:16px;">
                <strong>✅ Đổi mật khẩu thành công!</strong><br/>
                <span style="font-size:13px;">Đang chuyển hướng vào hệ thống...</span>
            </div>
        }
        else
        {
            <div class="form-group">
                <label class="form-label required">Mật khẩu hiện tại (do Admin cấp)</label>
                <div class="password-wrapper">
                    <input type="@(_showCurrent ? "text" : "password")" class="form-control"
                           placeholder="Nhập mật khẩu Admin đã cấp"
                           @bind="_model.CurrentPassword" disabled="@_isSaving"/>
                    <button type="button" class="password-toggle" @onclick="() => _showCurrent = !_showCurrent">
                        @EyeIcon(_showCurrent)
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label required">Mật khẩu mới</label>
                <div class="password-wrapper">
                    <input type="@(_showNew ? "text" : "password")" class="form-control"
                           placeholder="Tối thiểu 8 ký tự, có chữ hoa, chữ thường và số"
                           @bind="_model.NewPassword" @oninput="CheckStrength" disabled="@_isSaving"/>
                    <button type="button" class="password-toggle" @onclick="() => _showNew = !_showNew">
                        @EyeIcon(_showNew)
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_model.NewPassword))
                {
                    <div style="margin-top:6px;">
                        <div style="display:flex;gap:4px;margin-bottom:4px;">
                            @for (int i = 0; i < 4; i++)
                            {
                                var filled = i < _strength;
                                var color = _strength <= 1 ? "#ef4444" : _strength == 2 ? "#f97316" : _strength == 3 ? "#eab308" : "#22c55e";
                                <div style="flex:1;height:4px;border-radius:2px;background:@(filled ? color : "#e5e7eb");
                                            transition:background .3s;"></div>
                            }
                        </div>
                        <span style="font-size:12px;color:@(_strength <= 1 ? "#ef4444" : _strength == 2 ? "#f97316" : _strength == 3 ? "#eab308" : "#22c55e");">
                            @_strengthLabel
                        </span>
                    </div>
                }
            </div>

            <div class="form-group">
                <label class="form-label required">Xác nhận mật khẩu mới</label>
                <div class="password-wrapper">
                    <input type="@(_showConfirm ? "text" : "password")" class="form-control"
                           placeholder="Nhập lại mật khẩu mới"
                           @bind="_model.ConfirmPassword" disabled="@_isSaving"/>
                    <button type="button" class="password-toggle" @onclick="() => _showConfirm = !_showConfirm">
                        @EyeIcon(_showConfirm)
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_model.ConfirmPassword) && _model.NewPassword != _model.ConfirmPassword)
                {
                    <span style="font-size:12px;color:#ef4444;">Mật khẩu xác nhận không khớp.</span>
                }
            </div>

            <div style="border-top:1px solid var(--color-border-light);margin:20px 0 16px;">
                <p style="font-size:13px;color:var(--color-text-muted);margin:16px 0 12px;">
                    📧 Thêm email để có thể khôi phục mật khẩu sau này (tùy chọn)
                </p>
            </div>

            <div class="form-group">
                <label class="form-label">Email khôi phục</label>
                <input type="email" class="form-control" placeholder="vd: nguyenvan@hau.edu.vn"
                       @bind="_model.Email" disabled="@_isSaving"/>
            </div>

            <div class="form-group">
                <label class="form-label">Số điện thoại</label>
                <input type="tel" class="form-control" placeholder="vd: 0912345678"
                       @bind="_model.PhoneNumber" disabled="@_isSaving"/>
            </div>

            <button class="btn btn-primary login-btn" @onclick="HandleSubmit" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <div class="spinner spinner-sm" style="border-top-color:white;"></div>
                    <span>Đang lưu...</span>
                }
                else
                {
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>Xác nhận & Vào hệ thống</span>
                }
            </button>
        }

        <div class="login-footer">
            <p>© @DateTime.Now.Year Trường Đại học Kiến Trúc Hà Nội</p>
        </div>
    </div>
</div>

@code {
    private readonly ChangePasswordRequest _model = new();
    private string? _errorMessage;
    private bool _isSaving;
    private bool _success;
    private bool _showCurrent, _showNew, _showConfirm;
    private int    _strength;
    private string _strengthLabel = "";

    private void CheckStrength(ChangeEventArgs e)
    {
        var pw = e.Value?.ToString() ?? "";
        _strength = 0;
        if (pw.Length >= 8)            _strength++;
        if (pw.Any(char.IsUpper))      _strength++;
        if (pw.Any(char.IsLower))      _strength++;
        if (pw.Any(char.IsDigit) || pw.Any(c => !char.IsLetterOrDigit(c))) _strength++;
        _strengthLabel = _strength switch
        {
            1 => "Yếu",
            2 => "Trung bình",
            3 => "Mạnh",
            4 => "Rất mạnh",
            _ => ""
        };
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.CurrentPassword) ||
            string.IsNullOrWhiteSpace(_model.NewPassword) ||
            string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        {
            _errorMessage = "Vui lòng điền đầy đủ thông tin bắt buộc.";
            return;
        }
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "Mật khẩu mới và xác nhận không khớp.";
            return;
        }
        if (_model.NewPassword.Length < 8)
        {
            _errorMessage = "Mật khẩu mới phải có ít nhất 8 ký tự.";
            return;
        }

        _isSaving = true;
        var (success, error) = await AuthService.ChangePasswordAsync(_model);
        _isSaving = false;

        if (success)
        {
            _success = true;
            StateHasChanged();
            await Task.Delay(1500);
            NavManager.NavigateTo("/", forceLoad: false);
        }
        else
        {
            _errorMessage = error ?? "Có lỗi xảy ra. Vui lòng thử lại.";
        }
    }

    private RenderFragment EyeIcon(bool show) => show
        ? @<svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
          </svg>
        : @<svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>;
}
