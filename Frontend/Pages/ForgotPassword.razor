@page "/forgot-password"
@layout EmptyLayout
@inject AuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Quên mật khẩu - HAU Công văn</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-icon" style="background:linear-gradient(135deg,#1e3a5f,#2563eb);">
                <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
            </div>
            <div class="login-logo-text">
                <h1>HAU Documents</h1>
                <p>Quên mật khẩu</p>
            </div>
        </div>

        <h2 class="login-title">Khôi phục mật khẩu</h2>
        <p class="login-subtitle" style="margin-bottom:24px;">
            Nhập địa chỉ email đã đăng ký. Chúng tôi sẽ gửi mã OTP để đặt lại mật khẩu.
        </p>

        @if (_sent)
        {
            <div style="text-align:center;padding:24px 0;">
                <div style="width:56px;height:56px;background:#dcfce7;border-radius:50%;
                            display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#16a34a" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <p style="color:#166534;font-weight:600;margin-bottom:8px;">Email đã được gửi!</p>
                <p style="color:#6b7280;font-size:14px;line-height:1.6;">
                    Nếu địa chỉ <strong>@_email</strong> tồn tại trong hệ thống,<br/>
                    bạn sẽ nhận được mã OTP trong vài phút.
                </p>
                <button class="btn btn-primary" style="margin-top:20px;width:100%;"
                        @onclick="GoToReset">
                    Nhập mã OTP →
                </button>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="login-error">@_errorMessage</div>
            }

            <div class="form-group">
                <label class="form-label required">Địa chỉ email</label>
                <input type="email" class="form-control" placeholder="vd: nguyenvan@hau.edu.vn"
                       @bind="_email" disabled="@_isSending"/>
            </div>

            <button class="btn btn-primary login-btn" @onclick="HandleSubmit" disabled="@_isSending">
                @if (_isSending)
                {
                    <div class="spinner spinner-sm" style="border-top-color:white;"></div>
                    <span>Đang gửi...</span>
                }
                else
                {
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <span>Gửi mã OTP</span>
                }
            </button>
        }

        <div style="text-align:center;margin-top:16px;">
            <a href="/login" style="font-size:13.5px;color:var(--color-primary);text-decoration:none;">
                ← Quay lại đăng nhập
            </a>
        </div>

        <div class="login-footer">
            <p>© @DateTime.Now.Year Trường Đại học Kiến Trúc Hà Nội</p>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private string? _errorMessage;
    private bool _isSending, _sent;

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Vui lòng nhập địa chỉ email.";
            return;
        }

        _isSending = true;
        var (success, error) = await AuthService.ForgotPasswordAsync(_email);
        _isSending = false;

        if (success)
            _sent = true;
        else
            _errorMessage = error;
    }

    private void GoToReset() => NavManager.NavigateTo("/reset-password");
}
