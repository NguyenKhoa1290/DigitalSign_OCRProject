@page "/reset-password"
@layout EmptyLayout
@inject AuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Đặt lại mật khẩu - HAU Công văn</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-icon">
                <img src="images/hau-logo.png" alt="Biểu trưng Trường Đại học Kiến trúc Hà Nội" />
            </div>
            <div class="login-logo-text">
                <h1>HAU Documents</h1>
                <p>Đặt lại mật khẩu</p>
            </div>
        </div>

        <h2 class="login-title">Đặt lại mật khẩu</h2>
        <p class="login-subtitle reset-subtitle">
            Nhập mã OTP đã gửi về email và mật khẩu mới của bạn.
        </p>

        @if (_success)
        {
            <div class="reset-success">
                <div class="reset-success-icon">
                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#16a34a" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <p class="reset-success-title">Đặt lại mật khẩu thành công!</p>
                <p class="reset-success-text">Đang chuyển hướng đến trang đăng nhập...</p>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="login-error">@_errorMessage</div>
            }

            <div class="form-group">
                <label class="form-label required">Email đã đăng ký</label>
                <input type="email" class="form-control" placeholder="vd: nguyenvan@hau.edu.vn"
                       @bind="_model.Email" disabled="@_isSaving"/>
            </div>

            <div class="form-group">
                <label class="form-label required">Mã OTP (6 chữ số)</label>
                <input type="text" class="form-control otp-input" placeholder="Nhập mã OTP từ email"
                       maxlength="6" @bind="_model.Otp" disabled="@_isSaving"
                       />
                <span class="otp-hint">
                    ⏱ OTP có hiệu lực trong 15 phút
                </span>
            </div>

            <div class="form-group">
                <label class="form-label required">Mật khẩu mới</label>
                <div class="password-wrapper">
                    <input type="@(_showNew ? "text" : "password")" class="form-control"
                           placeholder="Tối thiểu 8 ký tự" @bind="_model.NewPassword" disabled="@_isSaving"/>
                    <button type="button" class="password-toggle" @onclick="() => _showNew = !_showNew">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label required">Xác nhận mật khẩu mới</label>
                <input type="password" class="form-control" placeholder="Nhập lại mật khẩu mới"
                       @bind="_model.ConfirmPassword" disabled="@_isSaving"/>
                @if (!string.IsNullOrEmpty(_model.ConfirmPassword) && _model.NewPassword != _model.ConfirmPassword)
                {
                    <span class="password-mismatch">Mật khẩu xác nhận không khớp.</span>
                }
            </div>

            <button class="btn btn-primary login-btn" @onclick="HandleSubmit" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <div class="spinner spinner-sm reset-spinner"></div>
                    <span>Đang xử lý...</span>
                }
                else
                {
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>Đặt lại mật khẩu</span>
                }
            </button>

            <div class="reset-links">
                <a href="/forgot-password" class="reset-link">
                    Gửi lại mã OTP
                </a>
                <span class="reset-link-separator">|</span>
                <a href="/login" class="reset-link">
                    Quay lại đăng nhập
                </a>
            </div>
        }

        <div class="login-footer">
            <p>© @DateTime.Now.Year Trường Đại học Kiến Trúc Hà Nội</p>
        </div>
    </div>
</div>

@code {
    private readonly ResetPasswordRequest _model = new();
    private string? _errorMessage;
    private bool _isSaving, _success, _showNew;

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Email) ||
            string.IsNullOrWhiteSpace(_model.Otp) ||
            string.IsNullOrWhiteSpace(_model.NewPassword) ||
            string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        {
            _errorMessage = "Vui lòng điền đầy đủ thông tin.";
            return;
        }
        if (_model.Otp.Length != 6 || !_model.Otp.All(char.IsDigit))
        {
            _errorMessage = "Mã OTP phải là 6 chữ số.";
            return;
        }
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "Mật khẩu xác nhận không khớp.";
            return;
        }
        if (_model.NewPassword.Length < 8)
        {
            _errorMessage = "Mật khẩu mới phải có ít nhất 8 ký tự.";
            return;
        }

        _isSaving = true;
        var (success, error) = await AuthService.ResetPasswordAsync(_model);
        _isSaving = false;

        if (success)
        {
            _success = true;
            StateHasChanged();
            await Task.Delay(2000);
            NavManager.NavigateTo("/login");
        }
        else
        {
            _errorMessage = error ?? "Mã OTP không hợp lệ hoặc đã hết hạn.";
        }
    }
}
