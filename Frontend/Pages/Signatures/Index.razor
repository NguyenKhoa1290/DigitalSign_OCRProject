@page "/signatures"
@page "/signatures/{DocId:guid}"
@attribute [Authorize(Roles = "Manager,BoardOfDirectors,Admin")]
@inject SignatureService SignatureService
@inject DocumentService DocumentService
@inject AuthService AuthService
@inject IToastService Toast
@inject NavigationManager NavManager

<PageTitle>Ký số - HAU</PageTitle>

<div class="page-header signature-page-header">
    <div>
        <h1 class="page-title">Ký số Tài liệu</h1>
        <p class="page-subtitle">Quản lý chữ ký số cho các văn bản</p>
    </div>
    <div class="signature-header-actions">
        <a href="@(DocId.HasValue ? $"/documents/{DocId.Value}" : "/documents")"
           class="btn btn-outline signature-back-button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            Quay lại
        </a>
        <a class="btn btn-outline" href="/verify-signature">Kiểm tra PDF bên ngoài</a>
    </div>
</div>

@if (DocId.HasValue)
{
    <!-- Document-specific signing view -->
    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (_document != null)
    {
        <div class="signature-layout">
            <div class="card">
                <div class="card-header"><span class="card-title">Thông tin Tài liệu</span></div>
                <div class="card-body">
                    <div class="signature-document-heading">
                        <h3 class="signature-document-title">@_document.Title</h3>
                        <div class="signature-document-meta">
                            <StatusBadge Status="@_document.Status" />
                            @if (!string.IsNullOrEmpty(_document.DocumentNumber))
                            {
                                <span class="signature-document-number">Số: @_document.DocumentNumber</span>
                            }
                        </div>
                    </div>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <div class="detail-label">Loại văn bản</div>
                            <div class="detail-value">@(_document.DocumentTypeName ?? "—")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Ngày ban hành</div>
                            <div class="detail-value">@(_document.IssuedDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                        </div>
                    </div>

                    <!-- Sign Buttons -->
                    <div class="signature-actions">
                        @if (CanPersonalSign)
                        {
                            @if (_alreadySignedPersonal)
                            {
                                <button class="btn btn-success" @onclick="FinishPersonalSign" disabled="@_isActionLoading">Hoàn tất bước ký nháy</button>
                            }
                            else
                            {
                            <button class="btn btn-success" @onclick='() => ShowSignModal("DeptSign")' disabled="@_isActionLoading">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                </svg>
                                Ký nháy (Manager)
                            </button>
                            }
                        }
                        @if (CanLegalSeal)
                        {
                            @if (_alreadySignedLegal)
                            {
                                <button class="btn btn-primary" @onclick="FinishLegalSign" disabled="@_isActionLoading">Hoàn tất bước ký pháp nhân</button>
                            }
                            else
                            {
                            <button class="btn btn-primary" @onclick='() => ShowSignModal("DirectorSign")' disabled="@_isActionLoading">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                                </svg>
                                Ký số pháp nhân (BGH)
                            </button>
                            }
                        }
                        <button class="btn btn-outline" @onclick="VerifySignatures" disabled="@(_isActionLoading || !IsPdfFile)">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            Xác minh chữ ký
                        </button>
                    </div>

                    @if (_verifyResult != null)
                    {
                        <div class="alert signature-verification @(_verifyResult.AllValid ? "alert-success" : "alert-danger")">
                            @if (_verifyResult.AllValid)
                            {
                                <span>@_verifyResult.Message</span>
                            }
                            else
                            {
                                <span>@(_verifyResult.Message ?? "Không xác nhận được toàn bộ chữ ký trên tài liệu.")</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header"><span class="card-title">Chữ ký hiện có (@(_signatures?.Count ?? 0))</span></div>
                <div class="card-body">
                    @if (_signatures == null || !_signatures.Any())
                    {
                        <div class="empty-state signature-empty-state">
                            <div class="empty-state-icon">
                                <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                </svg>
                            </div>
                            <p class="empty-state-title">Chưa có chữ ký</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var sig in _signatures)
                        {
                            <div class="sig-item">
                                <div class="sig-icon @(!sig.IsValid ? "sig-icon-invalid" : null)">
                                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                    </svg>
                                </div>
                                <div class="sig-info">
                                    <div class="sig-name">@GetSignatureSignerText(sig)</div>
                                    <div class="sig-meta">@GetSignatureTypeText(sig) • @VietnamTime.Format(sig.SignedAt)</div>
                                    @if (!string.IsNullOrEmpty(sig.CertificateSubject))
                                    {
                                        <div class="sig-meta">@sig.CertificateSubject</div>
                                    }
                                    <span class="sig-meta">Đã ghi nhận chữ ký. Chọn Xác minh chữ ký để kiểm tra tệp hiện tại.</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- Actor-scoped pending queue and personal signature history. -->
    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="tab-bar signature-tabs" role="tablist" aria-label="Danh sách ký số">
            <button type="button" class="tab-btn @(_listView == "pending" ? "active" : "")" role="tab" aria-selected="@(_listView == "pending")" @onclick='() => SetListView("pending")'>Chờ ký</button>
            <button type="button" class="tab-btn @(_listView == "signed" ? "active" : "")" role="tab" aria-selected="@(_listView == "signed")" @onclick='() => SetListView("signed")'>Đã ký</button>
        </div>
        @if (_list == null)
        {
            <p class="alert alert-danger" role="alert">Không tải được danh sách. Hãy thử lại.</p>
            <button class="btn btn-outline" @onclick="LoadList">Thử lại</button>
        }
        else if (_list.Items.Count == 0)
        {
            <div class="card"><div class="empty-state"><p class="empty-state-title">@(_listView == "pending" ? "Không có tài liệu chờ bạn ký" : "Bạn chưa ký tài liệu nào")</p></div></div>
        }
        else
        {
            <div class="signature-queue">
                <div class="signature-document-list">
                    @foreach (var doc in _list.Items)
                    {
                        <article class="card signature-list-item" @key="doc.Id">
                            <div class="card-body">
                                <a class="table-title" href="@($"/documents/{doc.Id}")">@doc.Title</a>
                                <div class="signature-document-meta">
                                    <StatusBadge Status="@doc.Status" />
                                    <span class="table-meta">@(doc.IsSchoolWide ? "Công văn chung" : doc.DepartmentName ?? "Chưa xác định đơn vị")</span>
                                </div>
                                @if (_listView == "signed") { <p class="table-meta">Bạn đã ký: @VietnamTime.Format(doc.MySignedAt)</p> }
                                <a class="btn btn-outline" href="@($"/documents/{doc.Id}")">@(_listView == "pending" ? "Xem và xử lý" : "Xem công văn")</a>
                            </div>
                        </article>
                    }
                </div>
                <div class="pagination signature-pagination">
                    <span class="pagination-info">@_list.TotalCount tài liệu · Trang @_list.Page / @_list.TotalPages</span>
                    <div class="pagination-controls">
                        <button class="page-btn" disabled="@(!_list.HasPreviousPage)" aria-label="Trang trước" @onclick="PreviousListPage">‹</button>
                        <button class="page-btn" disabled="@(!_list.HasNextPage)" aria-label="Trang sau" @onclick="NextListPage">›</button>
                    </div>
                </div>
            </div>
        }
    }
}

<!-- Sign Modal -->
@if (_showSignModal)
{
    <div class="modal-overlay" @onclick="CloseSignModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">@(_signType == "DeptSign" ? "Ký nháy" : "Ký số pháp nhân")</span>
                <button class="modal-close" @onclick="CloseSignModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Bạn sắp ký số tài liệu này bằng chứng thư số của mình.</span>
                </div>
                <p class="form-hint">Word hoặc nội dung OCR của ảnh sẽ được chuyển sang PDF trước khi ký. Sau khi ký, nội dung và tệp được khóa sửa.</p>
                <div class="form-group">
                    <label class="form-label">Ghi chú</label>
                    <textarea class="form-control" placeholder="Ghi chú..." @bind="_signComment" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseSignModal">Hủy</button>
                <button class="btn btn-success" @onclick="ExecuteSign" disabled="@_isActionLoading">
                    @if (_isActionLoading)
                    {
                        <div class="spinner spinner-sm signature-spinner"></div>
                        <span>Đang ký...</span>
                    }
                    else
                    {
                        <span>Ký số</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? DocId { get; set; }

    private DocumentDto? _document;
    private List<SignatureDto>? _signatures;
    private SignatureVerifyResult? _verifyResult;
    private string? _role;
    private bool _isLoading = true;
    private bool _isActionLoading;
    private bool _alreadySignedPersonal;
    private bool _alreadySignedLegal;
    private PagedResult<DocumentDto>? _list;
    private string _listView = "pending";
    private int _listPage = 1;

    private bool _showSignModal;
    private string _signType = "";
    private string _signComment = "";

    private bool IsPdfFile => (_document?.SignedPdfPath ?? _document?.MinioPath)?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true;
    private bool HasSigningSource => !string.IsNullOrWhiteSpace(_document?.MinioPath);
    private bool CanPersonalSign =>
        _document != null && HasSigningSource && _document.DocTypeName != "CongVanDen" &&
        (_document.Status == "PendingDeptReview" || _document.Status == "DeptSigned" && _signatures?.Count == 0 && _document.SignedPdfPath == null)
        && ((_role == "Manager" && _document.CanReview) || _role == "Admin");

    private bool CanLegalSeal =>
        _document != null && IsPdfFile && _document.DocTypeName != "CongVanDen" &&
        _document.Status == "PendingDirectorSign" && (_role == "BoardOfDirectors" || _role == "Admin");

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _document = null; _signatures = null; _verifyResult = null;
        _role = await AuthService.GetRoleAsync();

        if (DocId.HasValue)
        {
            _document = await DocumentService.GetDocumentAsync(DocId.Value);
            _signatures = await SignatureService.GetSignaturesAsync(DocId.Value);
            var actor = await AuthService.GetUserIdAsync();
            _alreadySignedPersonal = Guid.TryParse(actor, out var actorId) && _signatures?.Any(s => s.SignerId == actorId && s.SignatureType == "PersonalSignature") == true;
            _alreadySignedLegal = Guid.TryParse(actor, out actorId) && _signatures?.Any(s => s.SignerId == actorId && s.SignatureType == "LegalSeal") == true;
        }
        else await LoadList();

        _isLoading = false;
    }

    private async Task LoadList()
    {
        _isLoading = true;
        _list = await DocumentService.GetSigningDocumentsAsync(_listView, _listPage);
        _isLoading = false;
    }
    private async Task SetListView(string view) { _listView = view; _listPage = 1; await LoadList(); }
    private async Task PreviousListPage() { if (_listPage > 1) { _listPage--; await LoadList(); } }
    private async Task NextListPage() { if (_list?.HasNextPage == true) { _listPage++; await LoadList(); } }

    private void ShowSignModal(string type)
    {
        _signType = type;
        _signComment = "";
        _showSignModal = true;
    }
    private void CloseSignModal() => _showSignModal = false;

    private async Task ExecuteSign()
    {
        if (!DocId.HasValue) return;
        _isActionLoading = true;

        var userIdText = await AuthService.GetUserIdAsync();
        if (!Guid.TryParse(userIdText, out var signerId))
        {
            _isActionLoading = false;
            Toast.ShowError("Không xác định được người ký từ token đăng nhập.");
            return;
        }

        var signerName = await AuthService.GetUserNameAsync();
        var reason = string.IsNullOrWhiteSpace(_signComment)
            ? (_signType == "DirectorSign" ? "Ký pháp nhân" : "Ký nháy")
            : _signComment.Trim();

        var req = new SignRequestDto
        {
            DocId = DocId.Value,
            SignerId = signerId,
            SignerName = signerName,
            Reason = reason,
            SignatureType = _signType,
            Comment = _signComment
        };

        var result = await SignatureService.SignAsync(req);

        _isActionLoading = false;
        _showSignModal = false;

        if (result != null)
        {
            if (_signType == "DeptSign")
            {
                _alreadySignedPersonal = true;
                await FinishPersonalSign();
            }
            else
            {
                _alreadySignedLegal = true;
                await FinishLegalSign();
            }
            _document = await DocumentService.GetDocumentAsync(DocId.Value);
            _signatures = await SignatureService.GetSignaturesAsync(DocId.Value);
        }
        else
        {
            Toast.ShowError("Ký số thất bại. Vui lòng kiểm tra chứng thư số.");
        }
    }

    private async Task FinishPersonalSign()
    {
        if (!DocId.HasValue) return;
        _isActionLoading = true;
        try
        {
            if (await DocumentService.DeptSignDocumentAsync(DocId.Value, _signComment))
            {
                _document = await DocumentService.GetDocumentAsync(DocId.Value);
                Toast.ShowSuccess("Đã ký nháy và cập nhật trạng thái công văn.");
            }
            else Toast.ShowError("Đã ký PDF nhưng chưa cập nhật trạng thái. Hãy bấm Hoàn tất bước ký nháy để thử lại.");
        }
        finally { _isActionLoading = false; }
    }

    private async Task FinishLegalSign()
    {
        if (!DocId.HasValue) return;
        _isActionLoading = true;
        try
        {
            if (await DocumentService.DirectorSignDocumentAsync(DocId.Value, _signComment))
            {
                _document = await DocumentService.GetDocumentAsync(DocId.Value);
                Toast.ShowSuccess("Đã ký pháp nhân và cập nhật trạng thái công văn.");
            }
            else Toast.ShowError("Đã ký PDF nhưng chưa cập nhật trạng thái. Hãy bấm Hoàn tất bước ký pháp nhân để thử lại.");
        }
        finally { _isActionLoading = false; }
    }

    private async Task VerifySignatures()
    {
        if (!DocId.HasValue) return;
        _isActionLoading = true;
        _verifyResult = await SignatureService.VerifyAsync(DocId.Value);
        _isActionLoading = false;
    }

    private static string GetSignatureSignerText(SignatureDto sig)
    {
        if (!string.IsNullOrWhiteSpace(sig.SignerName))
            return sig.SignerName;

        return sig.SignerId == Guid.Empty ? "Người ký" : $"Người ký: {sig.SignerId}";
    }

    private static string GetSignatureTypeText(SignatureDto sig)
    {
        if (!string.IsNullOrWhiteSpace(sig.SignatureTypeDisplay))
            return sig.SignatureTypeDisplay;

        return sig.SignatureType switch
        {
            "PersonalSignature" => "Ký nháy",
            "LegalSeal" => "Ký pháp nhân",
            _ => sig.SignatureType
        };
    }
}
