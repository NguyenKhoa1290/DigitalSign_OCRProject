@page "/certificates/me"
@attribute [Authorize(Roles = "Manager,BoardOfDirectors")]
@inject SignatureService SignatureService
@inject IToastService Toast

<PageTitle>Chứng thư của tôi - HAU</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Chứng thư của tôi</h1>
        <p class="page-subtitle">Chứng thư X.509 dùng để ký số tài liệu bằng tài khoản hiện tại</p>
    </div>
</div>

@if (_isLoading)
{
    <LoadingSpinner />
}
else if (_certificate == null)
{
    <div class="card certificate-empty-card">
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
            </div>
            <p class="empty-state-title">Bạn chưa có chứng thư số</p>
            <p class="empty-state-desc">Hệ thống sẽ dùng danh tính trong tài khoản đăng nhập để tạo chứng thư có hiệu lực 365 ngày.</p>
            <button class="btn btn-primary certificate-create-button" @onclick="OpenIssueConfirmation">
                Tạo chứng thư của tôi
            </button>
        </div>
    </div>
}
else
{
    <div class="card my-certificate-card">
        <div class="card-header">
            <span class="card-title">Thông tin chứng thư</span>
            <span class="badge @(_certificate.IsValid ? "badge-green" : "badge-orange")">
                @(_certificate.IsValid ? "Đang hoạt động" : "Hết hạn")
            </span>
        </div>
        <div class="card-body certificate-detail-grid">
            <div class="detail-item">
                <div class="detail-label">Chủ thể</div>
                <div class="detail-value">@_certificate.FullName</div>
            </div>
            <div class="detail-item">
                <div class="detail-label">Tên đăng nhập</div>
                <div class="detail-value">@_certificate.Username</div>
            </div>
            <div class="detail-item">
                <div class="detail-label">Loại chứng thư</div>
                <div class="detail-value">@CertificateTypeLabel</div>
            </div>
            <div class="detail-item">
                <div class="detail-label">Hiệu lực</div>
                <div class="detail-value">@_certificate.NotBefore.ToLocalTime().ToString("dd/MM/yyyy") – @_certificate.NotAfter.ToLocalTime().ToString("dd/MM/yyyy")</div>
            </div>
            <div class="detail-item certificate-thumbprint">
                <div class="detail-label">Thumbprint</div>
                <div class="detail-value">@_certificate.Thumbprint</div>
            </div>
        </div>
        @if (!_certificate.IsValid)
        {
            <div class="card-footer certificate-card-footer">
                <button class="btn btn-primary" @onclick="OpenIssueConfirmation">Tạo lại chứng thư</button>
            </div>
        }
    </div>
}

@if (_showIssueConfirmation)
{
    <div class="modal-overlay" @onclick="CloseIssueConfirmation">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">Tạo chứng thư số</span>
                <button class="modal-close" @onclick="CloseIssueConfirmation">&times;</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    Hệ thống sẽ tạo cặp khóa RSA và chứng thư X.509 từ danh tính trong tài khoản của bạn. Chứng thư có hiệu lực 365 ngày.
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseIssueConfirmation" disabled="@_isIssuing">Hủy</button>
                <button class="btn btn-primary" @onclick="IssueCertificate" disabled="@_isIssuing">
                    @if (_isIssuing)
                    {
                        <div class="spinner spinner-sm certificate-spinner"></div>
                        <span>Đang tạo...</span>
                    }
                    else
                    {
                        <span>Tạo chứng thư</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CertificateDto? _certificate;
    private bool _isLoading = true;
    private bool _isIssuing;
    private bool _showIssueConfirmation;

    private string CertificateTypeLabel => _certificate?.CertificateType == "Organization"
        ? "Pháp nhân"
        : "Cá nhân";

    protected override async Task OnInitializedAsync()
    {
        _certificate = await SignatureService.GetMyCertificateAsync();
        _isLoading = false;
    }

    private void OpenIssueConfirmation() => _showIssueConfirmation = true;

    private void CloseIssueConfirmation()
    {
        if (!_isIssuing)
            _showIssueConfirmation = false;
    }

    private async Task IssueCertificate()
    {
        _isIssuing = true;
        var certificate = await SignatureService.IssueMyCertificateAsync();
        _isIssuing = false;

        if (certificate == null)
        {
            Toast.ShowError("Không thể tạo chứng thư số. Vui lòng kiểm tra lại hoặc liên hệ quản trị viên.");
            return;
        }

        _certificate = certificate;
        _showIssueConfirmation = false;
        Toast.ShowSuccess("Tạo chứng thư số thành công.");
    }
}
