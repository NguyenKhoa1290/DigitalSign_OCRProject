@* DepartmentTreeNode.razor - helper component for tree display *@
@using HauDocumentApp.Models

<div>
    <div class="tree-node @(SelectedId == Dept.Id ? "selected" : "")" @onclick="() => OnSelect.InvokeAsync(Dept)">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            @if (Dept.Children.Any())
            {
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            }
            else
            {
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
            }
        </svg>
        <span style="flex:1">@Dept.Name</span>
        @if (Dept.MemberCount > 0)
        {
            <span style="font-size:11px;color:var(--color-text-muted);background:var(--color-bg);padding:1px 6px;border-radius:10px;">@Dept.MemberCount</span>
        }
        <div style="display:flex;gap:4px;" @onclick:stopPropagation>
            <button class="btn btn-ghost btn-sm" style="padding:3px 6px;" @onclick="() => OnEdit.InvokeAsync(Dept)">
                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
            </button>
        </div>
    </div>
    @if (Dept.Children.Any())
    {
        <div class="tree-children">
            @foreach (var child in Dept.Children)
            {
                <DepartmentTreeNode Dept="@child" SelectedId="@SelectedId"
                    OnSelect="OnSelect" OnEdit="OnEdit" OnDelete="OnDelete" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public DepartmentDto Dept { get; set; } = null!;
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<DepartmentDto> OnSelect { get; set; }
    [Parameter] public EventCallback<DepartmentDto> OnEdit { get; set; }
    [Parameter] public EventCallback<DepartmentDto> OnDelete { get; set; }
}
