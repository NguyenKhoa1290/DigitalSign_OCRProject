@inject NotificationRealtimeService Notifications
@implements IAsyncDisposable

<div class="notification-bar">
    <a class="btn btn-outline notification-bell" href="/notifications" aria-label="@(Notifications.UnreadCount > 0 ? $"Thông báo: {Notifications.UnreadCount} chưa đọc" : "Thông báo")">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
        <span>Thông báo</span>
        @if (Notifications.UnreadCount > 0)
        { <span class="notification-count" aria-hidden="true">@(Notifications.UnreadCount > 99 ? "99+" : Notifications.UnreadCount.ToString())</span> }
    </a>
    <span class="sr-only" role="status" aria-live="polite">@(Notifications.UnreadCount > 0 ? $"{Notifications.UnreadCount} thông báo chưa đọc" : "Không có thông báo chưa đọc")</span>
</div>

@code {
    protected override void OnInitialized() => Notifications.Changed += Refresh;
    protected override void OnAfterRender(bool firstRender) { if (firstRender) Notifications.Start(); }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public async ValueTask DisposeAsync() { Notifications.Changed -= Refresh; await Notifications.StopAsync(); }
}
