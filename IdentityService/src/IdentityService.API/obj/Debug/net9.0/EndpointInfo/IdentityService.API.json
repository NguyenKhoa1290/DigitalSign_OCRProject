{
  "openapi": "3.0.1",
  "info": {
    "title": "Identity Service API",
    "description": "Dịch vụ xác thực và phân quyền (RBAC) cho Hệ thống Quản lý Công văn - Trường ĐH Kiến Trúc Hà Nội",
