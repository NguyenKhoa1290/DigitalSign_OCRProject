# OCR Service — Biến môi trường

# App
PORT=5051
DEBUG=false

# MinIO
MINIO_ENDPOINT=192.168.50.10:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=documents

# Document Service
DOCUMENT_SERVICE_URL=http://localhost:5049

# Kafka — ĐÃ BẬT
KAFKA_ENABLED=true
