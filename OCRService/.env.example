# OCR Service — Biến môi trường khi chạy OCRService độc lập ngoài Docker Compose root.
# Nếu chạy full stack bằng docker-compose.yml ở thư mục root, dùng .env.example ở root project.

# App
PORT=5051
DEBUG=false

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=documents

# Document Service
DOCUMENT_SERVICE_URL=http://localhost:5049
SERVICE_TOKEN=hau-dev-ocr-service-token
# SERVICE_TOKEN phải khớp ServiceAuth__OcrServiceToken của DocumentService.

# Kafka (đặt true nếu đã cài Kafka)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOCUMENT_UPLOADED=document.uploaded
KAFKA_CONSUMER_GROUP=ocr-service-group

# OCR
OCR_LANGUAGE=vi
OCR_USE_GPU=false
